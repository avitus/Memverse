<div class="white-box-with-margins">
	<div class="details-form">
	    
	  <fieldset>
	    <legend> Enter User login, email or name</legend>
	    
	      <%= form_tag( {}, { :id => 'advanced_search' } ) do %>
	        <p>
	        Search:     <%= text_field_tag( :search_param,  params[:search_param],  :size =>  40 )%>
	        <img class="spinner" id="ajax_spinner" src="/assets/indicator.gif" alt="Searching ..." style="display: none" /> 
	        </p>
	                      
	      <% end %>
	          
	  </fieldset>
	         
	</div>  
	
	<br>
	
	<div id="search_results">
	  <%= render :partial=>'search_user' %>
	</div>
</div>

<script type="text/javascript">
	$(document).ready(function() {
		var searchTimeout;
		$("#search_param").on('keyup', function() {
			clearTimeout(searchTimeout);
			var searchValue = $(this).val();
			
			// Show spinner
			$("#ajax_spinner").show();
			
			// Debounce the search to 500ms after user stops typing
			searchTimeout = setTimeout(function() {
				$.get("/utils/search_user", { search_param: searchValue },
					function(data){	
						$("#search_results").html(data);
						$("#ajax_spinner").hide();
				}, "html" );
			}, 500);
		});
	});
</script>