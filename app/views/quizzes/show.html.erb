<% page_title @quiz.name %>

<div class="white-box-bg">
  <div class="compact-quiz-show">
    <h1 class="compact-header">
      <%= @quiz.name %>
      <div class="quiz-actions-compact">
        <% if can? :manage, @quiz %>
          <%= link_to edit_quiz_path(@quiz), class: "btn btn-primary btn-compact" do %>
            <i class="fa fa-pencil"></i> Edit
          <% end %>
        <% end %>
        <%= link_to admin_quiz_dashboards_path, class: "btn btn-secondary btn-compact" do %>
          <i class="fa fa-arrow-left"></i> Back
        <% end %>
      </div>
    </h1>

    <% if @quiz.description.present? %>
      <p class="quiz-description-compact"><%= @quiz.description.html_safe %></p>
    <% end %>

    <!-- Compact Info Grid -->
    <div class="compact-info-grid">
      <div class="compact-info-item">
        <i class="fa fa-user"></i>
        <span class="info-label">Created by:</span>
        <span class="info-value"><%= link_to @quiz.user.name_or_login, @quiz.user %></span>
      </div>
      <div class="compact-info-item">
        <i class="fa fa-calendar"></i>
        <span class="info-label">Start:</span>
        <span class="info-value">
          <% if @quiz.start_time %>
            <%= @quiz.start_time.strftime("%b %d, %I:%M %p") %>
          <% else %>
            Not scheduled
          <% end %>
        </span>
      </div>
      <div class="compact-info-item">
        <i class="fa fa-question-circle"></i>
        <span class="info-label">Questions:</span>
        <span class="info-value"><%= @quizquestions.count %></span>
      </div>
      <div class="compact-info-item">
        <i class="fa fa-clock-o"></i>
        <span class="info-label">Duration:</span>
        <span class="info-value">
          <% if @quiz.quiz_length %>
            <% if @quiz.quiz_length >= 60 %>
              <%= (@quiz.quiz_length / 60.0).round(1) %> min
            <% else %>
              <%= @quiz.quiz_length %> sec
            <% end %>
          <% else %>
            10 min
          <% end %>
        </span>
      </div>
    </div>

    <!-- Questions Section -->
    <div class="compact-questions-section">
      <div class="section-header-compact">
        <h2><i class="fa fa-list"></i> Questions</h2>
        <% if can? :manage, @quiz %>
          <%= link_to new_quiz_question_path(:quiz => @quiz.id), class: "btn btn-success btn-compact" do %>
            <i class="fa fa-plus"></i> Add Question
          <% end %>
        <% end %>
      </div>

      <% if @quizquestions.any? %>
        <div class="compact-questions-list">
          <% @quizquestions.each do |question| %>
            <div class="compact-question-card">
              <div class="question-left">
                <span class="question-number-compact">#<%= question.question_no %></span>
                <span class="question-type-badge <%= question.question_type&.downcase %>">
                  <%= question.question_type || 'MCQ' %>
                </span>
              </div>
              
              <div class="question-middle">
                <% if question.passage.present? %>
                  <div class="question-passage-compact">
                    <strong>Passage:</strong> <%= truncate(question.passage, length: 100) %>
                  </div>
                <% end %>
                <div class="question-text-compact">
                  <%= truncate(question.mc_question, length: 150) %>
                </div>
              </div>
              
              <div class="question-right">
                <% if can? :manage, @quiz %>
                  <%= link_to edit_quiz_question_path(question), class: "action-btn edit", title: "Edit" do %>
                    <i class="fa fa-pencil"></i>
                  <% end %>
                  <%= link_to quiz_question_path(question), 
                              method: :delete, 
                              data: { confirm: "Are you sure?" }, 
                              class: "action-btn delete",
                              title: "Delete" do %>
                    <i class="fa fa-trash"></i>
                  <% end %>
                <% end %>
                <%= link_to quiz_question_path(question), class: "action-btn view", title: "View Details" do %>
                  <i class="fa fa-eye"></i>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="empty-state-compact">
          <i class="fa fa-question-circle"></i>
          <p>No questions added yet.</p>
          <% if can? :manage, @quiz %>
            <%= link_to "Add First Question", new_quiz_question_path(:quiz => @quiz.id), 
                        class: "btn btn-primary btn-compact" %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>
