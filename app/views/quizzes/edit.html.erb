<% page_title "Edit Quiz" %>

<div class="white-box-bg">
  <div class="compact-quiz-edit">
    <h1 class="compact-header">
      Edit Quiz
      <span class="quiz-info-badges">
        <span class="info-badge"><i class="fa fa-question-circle"></i> <%= @quiz.quiz_questions.count %> questions</span>
        <% if @quiz.start_time && @quiz.start_time < Time.current %>
          <span class="info-badge completed"><i class="fa fa-check-circle"></i> Completed</span>
        <% end %>
      </span>
    </h1>

  <%= form_for(@quiz, html: { multipart: true, class: 'quiz-form compact' }) do |f| %>

    <% if @quiz.errors.any? %>
      <div class="compact-errors">
        <i class="fa fa-exclamation-circle"></i>
        <span class="error-text">
          <%= @quiz.errors.full_messages.join(', ') %>
        </span>
      </div>
    <% end %>

    <div class="compact-grid">
      <div class="compact-section details-section">
        <h3><i class="fa fa-info-circle"></i> Details</h3>
        
        <div class="compact-field">
          <%= f.label :name, 'Name *' %>
          <%= f.text_field :name, class: 'form-control' %>
        </div>
        
        <div class="compact-field">
          <%= f.label :description %>
          <%= f.text_area :description, rows: 3, class: 'form-control' %>
        </div>
      </div>

      <div class="compact-section schedule-section">
        <h3><i class="fa fa-calendar"></i> Schedule</h3>
        
        <div class="compact-field">
          <%= f.label :start_time, 'Start Time (UTC) *' %>
          <div class="datetime-compact">
            <%= f.date_field :start_time, value: @quiz.start_time&.strftime("%Y-%m-%d"), class: 'form-control' %>
            <%= f.time_field :start_time, value: @quiz.start_time&.strftime("%H:%M"), class: 'form-control' %>
          </div>
        </div>
        
        <div class="time-preview">
          <span id="scheduled-time-display"></span>
          <span id="time-until"></span>
        </div>
      </div>

      <div class="compact-section quick-section">
        <h3><i class="fa fa-bolt"></i> Quick Schedule</h3>
        
        <div class="utc-notice">
          <i class="fa fa-clock-o"></i> UTC: <span id="current-utc-time"><%= Time.current.utc.strftime("%H:%M") %></span>
        </div>
        
        <div class="quick-btns-vertical">
          <button type="button" class="quick-btn primary" data-minutes="2">Now + 2 min</button>
          <button type="button" class="quick-btn" data-offset="1">Tomorrow</button>
          <button type="button" class="quick-btn" data-offset="7">Next Week</button>
          <button type="button" class="quick-btn" data-time="14:00">2:00 PM UTC</button>
          <button type="button" class="quick-btn" data-time="19:00">7:00 PM UTC</button>
        </div>
      </div>
    </div>

    <div class="compact-actions">
      <%= link_to 'Cancel', @quiz, class: 'btn btn-secondary' %>
      <div class="right-btns">
        <%= link_to 'View', @quiz, class: 'btn btn-info' %>
        <%= f.submit 'Update', class: 'btn btn-primary' %>
      </div>
    </div>

  <% end %>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Update current UTC time every second
    function updateCurrentTime() {
      const now = new Date();
      const hours = String(now.getUTCHours()).padStart(2, '0');
      const minutes = String(now.getUTCMinutes()).padStart(2, '0');
      document.getElementById('current-utc-time').textContent = `${hours}:${minutes}`;
    }
    updateCurrentTime();
    setInterval(updateCurrentTime, 1000);

    // Date and time inputs
    const dateInput = document.querySelector('input[type="date"]');
    const timeInput = document.querySelector('input[type="time"]');
    const timeDisplay = document.getElementById('scheduled-time-display');
    const timeUntil = document.getElementById('time-until');

    // Update preview when date or time changes
    function updatePreview() {
      if (dateInput.value && timeInput.value) {
        const scheduledDate = new Date(dateInput.value + 'T' + timeInput.value + ':00Z');
        
        // Display the scheduled time in a compact format
        const options = { 
          month: 'short', 
          day: 'numeric', 
          hour: '2-digit', 
          minute: '2-digit',
          timeZone: 'UTC',
          hour12: false
        };
        timeDisplay.textContent = scheduledDate.toLocaleString('en-US', options) + ' UTC';
        
        // Calculate time until
        const now = new Date();
        const diff = scheduledDate - now;
        
        if (diff > 0) {
          const minutes = Math.floor(diff / (1000 * 60));
          const hours = Math.floor(minutes / 60);
          const days = Math.floor(hours / 24);
          const remainingHours = hours % 24;
          const remainingMinutes = minutes % 60;
          
          let untilText = '';
          if (days > 0) {
            untilText = days + 'd ' + remainingHours + 'h';
          } else if (hours > 0) {
            untilText = hours + 'h ' + remainingMinutes + 'm';
          } else {
            untilText = minutes + ' minutes';
          }
          
          timeUntil.textContent = '(' + untilText + ')';
          timeUntil.style.color = '#6b7280';
        } else {
          timeUntil.textContent = '(Past date)';
          timeUntil.style.color = '#ef4444';
        }
      } else {
        timeDisplay.textContent = 'Select date and time';
        timeUntil.textContent = '';
      }
    }

    dateInput.addEventListener('change', updatePreview);
    timeInput.addEventListener('change', updatePreview);

    // Quick schedule buttons
    const quickButtons = document.querySelectorAll('.quick-btn');
    quickButtons.forEach(button => {
      button.addEventListener('click', function() {
        const offset = this.getAttribute('data-offset');
        const fixedTime = this.getAttribute('data-time');
        const minutesFromNow = this.getAttribute('data-minutes');
        
        const date = new Date();
        
        if (minutesFromNow) {
          // Add minutes to current time
          date.setUTCMinutes(date.getUTCMinutes() + parseInt(minutesFromNow));
        } else if (offset) {
          date.setUTCDate(date.getUTCDate() + parseInt(offset));
        }
        
        if (fixedTime) {
          const [hours, minutes] = fixedTime.split(':');
          date.setUTCHours(parseInt(hours), parseInt(minutes), 0, 0);
        }
        
        // Set the date and time inputs
        const year = date.getUTCFullYear();
        const month = String(date.getUTCMonth() + 1).padStart(2, '0');
        const day = String(date.getUTCDate()).padStart(2, '0');
        const hours = String(date.getUTCHours()).padStart(2, '0');
        const minutes = String(date.getUTCMinutes()).padStart(2, '0');
        
        dateInput.value = `${year}-${month}-${day}`;
        timeInput.value = `${hours}:${minutes}`;
        
        updatePreview();
      });
    });

    // Initial preview update
    updatePreview();
  });
</script>
