<h1><%=h @sermon.title %></h1>

<p>
  <b>Pastor:</b>
  <%=h @sermon.pastor.name %>
</p>

<p>
  <b>Key Verse:</b>
  <%=h @sermon.uberverse.ref %>
</p>
  
<p>
  <b>Church:</b>
  <%=h @sermon.church.name %>
</p>

<p>
  <%=h @sermon.summary %>
</p>

<% if @sermon.mp3_url.present? %>
<p>
  <b>Mp3:</b>
  <% if @sermon.mp3_attachment.attached? %>
    <%= link_to @sermon.mp3_attachment.filename, @sermon.mp3_url %>
    <span style="color: #666; font-size: 0.9em;">(Active Storage)</span>
  <% else %>
    <%= link_to @sermon.mp3_file_name, @sermon.mp3_url %>
    <span style="color: #666; font-size: 0.9em;">(Paperclip)</span>
  <% end %>
  <br>
</p>

<audio src="<%= @sermon.mp3_url %>" controls="controls">
	Your browser does not support the audio element. You will need to upgrade to a modern browser.
</audio>
<% else %>
<p>
  <b>Mp3:</b> No audio file available
</p>
<% end %>

<p>
  Uploaded by: <%=h @sermon.user.name_or_login %>
</p>


<%= link_to 'Edit', edit_sermon_path(@sermon) %> |
<%= link_to 'Back', sermons_path %>
