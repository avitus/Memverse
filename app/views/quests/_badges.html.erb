<% if heritage_enabled? %><h2>Your awards</h2><% end %>
<div class="badges-container">
	<div class="sermon-on-the-mount unearned" title="Sermon on the Mount"><% if heritage_enabled? %><%= render "quests/heritage_medal", kind: "mount" %><span class="heritage-award-label">Sermon on the Mount</span><span class="heritage-award-tier">Not yet earned</span><% end %></div>
	<div class="consistency         unearned" title="Consistency"><% if heritage_enabled? %><%= render "quests/heritage_medal", kind: "flame" %><span class="heritage-award-label">Consistency</span><span class="heritage-award-tier">Not yet earned</span><% end %></div>
	<div class="referrer            unearned" title="Referrer"><% if heritage_enabled? %><%= render "quests/heritage_medal", kind: "people" %><span class="heritage-award-label">Referrer</span><span class="heritage-award-tier">Not yet earned</span><% end %></div>
	<div class="quiz-champion       unearned" title="Quiz Champion"><% if heritage_enabled? %><%= render "quests/heritage_medal", kind: "cup" %><span class="heritage-award-label">Quiz Champion</span><span class="heritage-award-tier">Not yet earned</span><% end %></div>
</div>

<script type="text/javascript">
$(document).ready(function() {
	$.getJSON('/earned_badges/<%=@user.id%>.json', function(badges_array) {
		$.each(badges_array, function(index, badge) {
			var badgeclass = badge.name.replace(/ +/g, '-').toLowerCase();
			$('.badges-container .' + badgeclass + ' .heritage-award-tier').text(badge.color === 'solo' ? 'Earned' : badge.color.charAt(0).toUpperCase() + badge.color.slice(1));
			switch( badge.color ) {
				case 'gold'  : $("." + badgeclass).removeClass("unearned").addClass("earned-gold");   break;
				case 'silver': $("." + badgeclass).removeClass("unearned").addClass("earned-silver"); break;
				case 'bronze': $("." + badgeclass).removeClass("unearned").addClass("earned-bronze"); break;
				case 'solo'  : $("." + badgeclass).removeClass("unearned").addClass("earned");        break;
			}
		});
	}).fail(function(jqXHR, textStatus, errorThrown) {
		console.log("Failed to load badges: " + textStatus);
	});
});
</script>