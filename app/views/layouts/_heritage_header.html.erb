<header class="heritage-header">
  <%= link_to main_app.root_path, class: 'heritage-brand', 'aria-label': 'Memverse home' do %><svg width="34" height="34" viewBox="0 0 48 48" aria-hidden="true"><circle cx="24" cy="24" r="23" fill="currentColor"/><path d="M8 31V19c0-6 8-6 8 0v12m0-12c0-6 8-6 8 0v12m4-15 6.5 15L41 16" fill="none" stroke="var(--mv-surface)" stroke-width="3.8" stroke-linecap="round" stroke-linejoin="round"/></svg>memverse<% end %>
  <% unless heritage_auth_page? %><nav aria-label="Main navigation"><%= link_to 'Today', main_app.root_path %><%= link_to 'Review', main_app.passage_review_path %><%= link_to 'Learn', main_app.add_verse_path %><%= link_to 'Blog', bloggity.root_path %></nav><% end %>
  <div class="heritage-header-actions">
  <% if user_signed_in? %><details class="heritage-menu"><summary>Explore</summary><div>
    <%= link_to 'Dashboard and awards', main_app.user_path(current_user) %><%= link_to 'My verses', main_app.manage_verses_path %><%= link_to 'Add verses', main_app.add_verse_path %><%= link_to 'Progress', main_app.progress_path %><%= link_to 'Profile settings', main_app.update_profile_path %><%= link_to 'Single-verse review', main_app.test_verse_quick_path %><%= link_to 'Passage review', main_app.passage_review_path %><%= link_to 'Practice references', main_app.test_ref_path %><%= link_to 'Accuracy test', main_app.test_accuracy_path %><%= link_to 'Chapter review', main_app.pre_chapter_path %><%= link_to 'Voice review', main_app.voice_review_path %><%= link_to 'Search Bible', main_app.search_verse_path %><%= link_to 'Popular verses', main_app.popular_verses_path %><%= link_to 'Tag cloud', main_app.tag_cloud_path %><%= link_to 'News', main_app.news_path %><%= link_to 'Learn', main_app.learn_path %><%= link_to 'Practice', main_app.drill_verse_path %><%= link_to 'Church', main_app.church_path %><%= link_to 'Group', main_app.mygroup_path %><%= link_to 'Referrals', main_app.referrals_path(current_user) %><%= link_to 'Leaderboards', main_app.leaderboard_path %><%= link_to 'Quiz', main_app.live_quiz_path %><%= link_to 'My quiz questions', main_app.quiz_questions_path %><%= link_to 'Submit quiz question', main_app.submit_question_path %><%= link_to 'Forums', thredded.root_path %><%= link_to 'Chat', main_app.chat_path %><%= link_to 'Help', main_app.faq_path %><%= link_to 'Contact', main_app.contact_path %><% if current_user.admin? %><%= link_to 'Admin', main_app.admin_dashboard_path %><% end %><%= link_to 'Sign out', main_app.destroy_user_session_path, method: :delete %>
  </div></details>
  <% elsif controller_name == 'sessions' %><%= link_to 'Create an account', main_app.new_user_registration_path %>
  <% else %><%= link_to 'Sign in', main_app.new_user_session_path %><% end %>
  <button type="button" id="heritage-theme" aria-label="Use dark appearance">Dark</button>
  </div>
</header>
