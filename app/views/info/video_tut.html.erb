<a id="inline" title="Memverse Tutorial Video" href="https://www.youtube.com/watch?v=MAWn3qfkGrA&fs=1&feature=player_embedded&rel=0">Memverse Tutorial Video</a>

<script>
	$(document).ready(function() {			
		$("#inline").click(function(e) {
			e.preventDefault();
			
			// Get the original href
			var originalUrl = $(this).attr('href');
			console.log('Original URL:', originalUrl);
			
			// Convert YouTube watch URL to embed URL
			var videoUrl = originalUrl.replace("watch?v=", "embed/");
			
			// Remove any extra parameters from the original URL first
			if (videoUrl.indexOf('&') > -1) {
				videoUrl = videoUrl.substring(0, videoUrl.indexOf('&'));
			}
			
			// Add embed parameters
			videoUrl += "?autoplay=1&rel=0";
			
			console.log('Converted URL:', videoUrl);
			
			openVideoModal(videoUrl, this.title || 'Memverse Tutorial');
			return false;
		});	
	});	
</script>