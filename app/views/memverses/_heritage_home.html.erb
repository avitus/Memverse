<% page_title 'Today · Memverse' %>
<% home = heritage_home_data(current_user) %>
<div class="heritage-today">
<div class="heritage-page-heading"><div><span class="heritage-eyebrow"><%= Date.current.strftime('%A, %B %-d') %></span><h1>Welcome back, <%= current_user.name_or_login %>.</h1><p class="heritage-muted">Thy word have I hid in mine heart, that I might not sin against thee.</p><small>Psalm 119:11 · KJV</small></div><p class="heritage-purpose">Learn with attention.<br><strong>Review with purpose.</strong></p></div>
<div class="heritage-today-grid">
  <section class="heritage-today-review"><div class="heritage-page-heading"><span class="heritage-eyebrow">Today’s Scripture review</span><span class="heritage-review-symbol" aria-hidden="true">↻</span></div><div class="heritage-due-heading"><strong><%= number_with_delimiter(@due_today) %></strong><div><h2><%= 'verse'.pluralize(@due_today) %> due today</h2><p>From your collection of <%= number_with_delimiter(home[:total]) %> verses.</p></div></div><div class="heritage-actions"><%= link_to 'Start passage review →', passage_review_path, class: 'heritage-primary' %><%= link_to 'Review individual verses ↗', test_verse_quick_path %></div><div class="heritage-review-summary"><span><%= current_user.work_load %> minutes of practice</span><span><%= @overdue %> overdue</span><span><%= pluralize(@due_refs, 'reference') %> due</span></div></section>
  <section class="heritage-retained"><div class="heritage-page-heading"><h2>Verses retained</h2><%= link_to 'View progress ↗', progress_path %></div><div class="heritage-retained-number"><strong><%= number_with_delimiter(home[:counts].fetch('Memorized', 0)) %></strong><span>Verses memorized<br><small>Of <%= number_with_delimiter(home[:total]) %> in your collection</small></span></div>
    <% if home[:history].any? %><svg class="heritage-history" viewBox="0 0 500 120" preserveAspectRatio="none" role="img" aria-label="Your memorized verse history over the last six months"><path class="heritage-history-grid" d="M0 20h500M0 65h500M0 110h500"/><polyline points="<%= heritage_history_points(home[:history]) %>"/><% if home[:history].length == 1 %><circle cx="250" cy="<%= heritage_history_points(home[:history]).split(',').last %>" r="4"/><% end %></svg><div class="heritage-history-dates"><span><%= home[:history].first.first.strftime('%b %-d') %></span><span><%= home[:history].last.first.strftime('%b %-d') %></span></div><details><summary>View history data</summary><ul><% home[:history].each do |date, count| %><li><%= date %>: <%= pluralize(count, 'verse') %> memorized</li><% end %></ul></details><% else %><p>Your review history will appear here as you practice.</p><% end %>
  </section>
</div>
<div class="heritage-collection-ribbon"><span><b><%= number_with_delimiter(home[:total]) %></b> total verses</span><% [['Memorized','memorized'],['Learning','learning'],['Pending','pending']].each do |label, tone| %><span><i class="heritage-swatch <%= tone %>"></i><%= number_with_delimiter(home[:counts].fetch(label, 0)) %> <%= label.downcase %></span><% end %><%= link_to 'Search your collection ↗', manage_verses_path %></div>
<div class="heritage-today-grid heritage-today-lower"><section class="heritage-review-queue"><div class="heritage-page-heading"><h2>Next in your review queue</h2><%= link_to 'All your verses ↗', manage_verses_path %></div><% home[:queue].each do |memverse| %><%= link_to memory_verse_path(memverse), class: 'heritage-queue-row' do %><span class="heritage-book-icon" aria-hidden="true">▤</span><span><b><%= memverse.verse.ref %></b><small><%= memverse.verse.translation %></small></span><span class="heritage-status <%= memverse.status.downcase %>"><%= memverse.status %></span><span>View verse →</span><% end %><% end %><% if home[:queue].empty? %><p>No verses due. <%= link_to 'Learn your next verse →', add_verse_path %></p><% end %></section><section class="heritage-practice"><span class="heritage-eyebrow">A steady practice</span><h2>Return to the Word.</h2><p><%= pluralize(home[:practice_dates].length, 'day') %> with a completed review in the last seven days.</p><div class="heritage-week"><% (6.days.ago.to_date..Date.current).each do |date| %><span class="<%= 'done' if home[:practice_dates].include?(date) %>" title="<%= date %>"><small><%= date.strftime('%a') %></small><b><%= home[:practice_dates].include?(date) ? '✓' : '·' %></b></span><% end %></div><%= link_to 'Your dashboard and awards ↗', user_path(current_user) %></section></div>
</div>
<% if @user_has_no_verses || @user_has_too_few_verses %><section class="heritage-home-section"><h2>Start with words that matter.</h2><p>Choose a verse you would like to carry with you. We’ll help you keep it close through regular review.</p><div class="heritage-actions"><%= link_to 'Choose your next verse', add_verse_path %><%= link_to 'Getting started', tutorial_path %><%= link_to 'Profile settings', update_profile_path %></div></section><% end %>
<% if @user_has_no_verses %><details class="heritage-home-section"><summary>Start with a collection of popular verses</summary><p>Choose a starter collection in your preferred translation.</p><div class="heritage-actions"><% { 'NIV' => 'New International Version (1984)', 'ESV' => 'English Standard Version', 'KJV' => 'King James Version', 'NKJ' => 'New King James Version', 'NAS' => 'New American Standard' }.each do |translation, label| %><%= link_to label, action: 'starter_pack', translation: translation %><% end %></div></details><% end %>
<section class="heritage-home-section heritage-two-columns"><div><span class="heritage-eyebrow">A moment in Scripture</span><blockquote class="heritage-scripture"><%= @votd_txt %><cite><%= @votd_ref %> · <%= @votd_tl %></cite></blockquote></div><div><span class="heritage-eyebrow">Growing together</span><h2><%= number_with_delimiter(Memverse.memorized.count) %></h2><p>Verses memorized by the Memverse community.</p><p><%= @quests_to_next_level.capitalize %> to reach level <%= current_user.level + 1 %>.</p><%= link_to 'Your awards and progress →', user_path(current_user) %></div></section>
<% if current_user.swamped? %><details class="heritage-home-section"><summary>Adjust your review schedule</summary><p>If you have fallen behind, you can reset your schedule without removing your verses.</p><%= link_to 'Reset my schedule', reset_schedule_path, class: 'heritage-secondary', id: 'heritage-reset-schedule' %></details><% end %>
<section class="heritage-home-section"><div class="heritage-page-heading"><h2>Recently on Memverse</h2><%= link_to 'Community →', tweets_path %></div><div class="heritage-two-columns"><% [@tweets1, @tweets2].each do |tweets| %><ul class="heritage-activity"><% tweets.each do |tweet| %><li><%= sanitize(tweet.news) %><small><%= time_ago_in_words(tweet.created_at) %> ago</small></li><% end %></ul><% end %></div><%= link_to 'Join the discussions →', thredded.root_path %></section>
<% if @dd %><details class="heritage-home-section"><summary>Spurgeon’s daily devotion · <%= @dd.ref %></summary><div class="heritage-scripture"><%= sanitize(@dd.thought) %></div></details><% end %>
