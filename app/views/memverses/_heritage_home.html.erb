<% page_title 'Today · Memverse' %>
<main class="heritage-review-home">
  <h1>Today’s review</h1>
  <div class="review-cards">
    <%= render 'review_card', kind: 'verse', count: @due_today, path: passage_review_path, primary: @due_today.positive? %>
    <%= render 'review_card', kind: 'reference', count: @due_refs, path: test_ref_path, primary: @due_today.zero? && @due_refs.positive? %>
  </div>

  <dl class="practice-summary">
    <div>
      <dt>Current streak</dt>
      <dd><strong><%= number_with_delimiter(@review_streak) %></strong> <%= 'day'.pluralize(@review_streak) %></dd>
    </div>
    <div>
      <dt>Verses memorized</dt>
      <dd>
        <strong><%= number_with_delimiter(@memorized) %></strong> of <%= number_with_delimiter(@collection_size) %>
        <% if @collection_size.positive? %>
          <progress value="<%= @memorized %>" max="<%= @collection_size %>" aria-label="Verses memorized"></progress>
        <% end %>
      </dd>
    </div>
  </dl>
</main>
