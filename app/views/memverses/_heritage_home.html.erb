<% page_title 'Today · Memverse' %>
<div class="heritage-page-heading"><div><span class="heritage-eyebrow">Your daily practice</span><h1>A little time in the Word.</h1><p class="heritage-muted">Welcome back, <%= current_user.name_or_login %>.</p></div><%= link_to 'Your dashboard →', user_path(current_user), class: 'heritage-secondary' %></div>
<section class="heritage-today-review"><div><span class="heritage-eyebrow">Ready when you are</span><h2><%= pluralize(@due_today, 'verse') %> to review.</h2><p><%= current_user.work_load %> minutes of practice · <%= @overdue %> overdue · <%= pluralize(@due_refs, 'reference') %> due</p></div><div class="heritage-actions"><%= link_to 'Begin review →', passage_review_path, class: 'heritage-primary' %><%= link_to 'Add a verse', add_verse_path, class: 'heritage-secondary' %></div></section>
<% if @user_has_no_verses || @user_has_too_few_verses %><section class="heritage-home-section"><h2>Start with words that matter.</h2><p>Choose a verse you would like to carry with you. We’ll help you keep it close through regular review.</p><div class="heritage-actions"><%= link_to 'Choose your next verse', add_verse_path %><%= link_to 'Getting started', tutorial_path %><%= link_to 'Profile settings', update_profile_path %></div></section><% end %>
<% if @user_has_no_verses %><details class="heritage-home-section"><summary>Start with a collection of popular verses</summary><p>Choose a starter collection in your preferred translation.</p><div class="heritage-actions"><% { 'NIV' => 'New International Version (1984)', 'ESV' => 'English Standard Version', 'KJV' => 'King James Version', 'NKJ' => 'New King James Version', 'NAS' => 'New American Standard' }.each do |translation, label| %><%= link_to label, action: 'starter_pack', translation: translation %><% end %></div></details><% end %>
<section class="heritage-home-section heritage-two-columns"><div><span class="heritage-eyebrow">A moment in Scripture</span><blockquote class="heritage-scripture"><%= @votd_txt %><cite><%= @votd_ref %> · <%= @votd_tl %></cite></blockquote></div><div><span class="heritage-eyebrow">Growing together</span><h2><%= number_with_delimiter(Memverse.memorized.count) %></h2><p>Verses memorized by the Memverse community.</p><p><%= @quests_to_next_level.capitalize %> to reach level <%= current_user.level + 1 %>.</p><%= link_to 'Your awards and progress →', user_path(current_user) %></div></section>
<% if current_user.swamped? %><details class="heritage-home-section"><summary>Adjust your review schedule</summary><p>If you have fallen behind, you can reset your schedule without removing your verses.</p><%= link_to 'Reset my schedule', reset_schedule_path, class: 'heritage-secondary', id: 'heritage-reset-schedule' %></details><% end %>
<section class="heritage-home-section"><div class="heritage-page-heading"><h2>Recently on Memverse</h2><%= link_to 'Community →', tweets_path %></div><div class="heritage-two-columns"><% [@tweets1, @tweets2].each do |tweets| %><ul class="heritage-activity"><% tweets.each do |tweet| %><li><%= sanitize(tweet.news) %><small><%= time_ago_in_words(tweet.created_at) %> ago</small></li><% end %></ul><% end %></div><%= link_to 'Join the discussions →', thredded.root_path %></section>
<% if @dd %><details class="heritage-home-section"><summary>Spurgeon’s daily devotion · <%= @dd.ref %></summary><div class="heritage-scripture"><%= sanitize(@dd.thought) %></div></details><% end %>
