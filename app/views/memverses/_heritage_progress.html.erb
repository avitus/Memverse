<% page_title 'Your progress' %>
<div class="heritage-page-heading"><div><span class="heritage-eyebrow">A practice that grows</span><h1>Your progress</h1></div><%= link_to 'Continue practicing →', test_verse_quick_path, class: 'heritage-primary' %></div>
<% if current_user.memverses.empty? %><div class="white-box-with-margins"><h2>Start with one verse.</h2><p>Your progress begins with your first review.</p><%= link_to 'Add a verse', add_verse_path, class: 'heritage-primary' %></div>
<% elsif !current_user.finished_a_mem_session? %><div class="white-box-with-margins"><h2>Your first review is waiting.</h2><p>Complete a memorization session to see your progress here.</p></div>
<% else %>
<div class="heritage-stats"><div class="heritage-stat"><span>Memorized</span><strong><%= current_user.memorized %></strong><small>Of <%= current_user.memverses.count %> verses</small></div><div class="heritage-stat"><span>Sessions</span><strong><%= current_user.completed_sessions(:year) %></strong><small>In the preceding year</small></div><div class="heritage-stat"><span>Daily review</span><strong><%= current_user.work_load %> min</strong><small>Estimated time required</small></div></div>
<section class="white-box-with-margins" data-heritage-chart="memory"><div class="heritage-page-heading"><h2>Scripture taking root</h2><label>Show <select data-chart-range><option value="year">1 year</option><option value="all">All time</option></select></label></div><p data-chart-status role="status">Loading your history…</p><button type="button" data-chart-retry hidden>Try again</button><div id="heritage-progress" style="height:360px"></div><details><summary>View chart data</summary><div data-chart-table class="heritage-chart-table"></div></details><p class="heritage-muted">Memorized means a review interval longer than 30 days. Review minutes estimate daily time needed.</p></section>
<section class="white-box-with-margins" data-heritage-chart="consistency"><h2>Consistency over time</h2><p class="heritage-muted">Memorization sessions in the preceding year.</p><p data-chart-status role="status">Loading your history…</p><button type="button" data-chart-retry hidden>Try again</button><div id="heritage-consistency" style="height:250px"></div><details><summary>View chart data</summary><div data-chart-table class="heritage-chart-table"></div></details></section>
<details class="heritage-progress-help"><summary>Make room for your next verse</summary><p>If your estimated review time is below your target, <%= link_to 'add one or two verses', add_verse_path %>. As recall improves, the time required falls. You can also <%= link_to 'practice verse references', test_ref_path %>.</p></details>
<% end %>
