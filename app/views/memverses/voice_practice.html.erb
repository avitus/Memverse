<% page_title "Voice Practice" %>

<div class="white-box-bg">
<div class="main-verse-review">

    <div class="passage-entry voice-practice">

      <!-- Verse Reference and Passage Title Row -->
      <div class="voice-header">
        <div class="voice-reference">
          <h2>
            <span class="verse-ref"></span>
            <span class="verse-tl"></span>
          </h2>
        </div>
        <div class="passage-title-container">
          <h2 class="passage-title"></h2>
          <div class="passage-id" style="display:none;"></div>
        </div>
      </div>

      <!-- Microphone Control -->
      <div class="voice-controls">
        <button id="mic-button" class="mic-button">
          <span class="mic-icon">🎤</span>
        </button>
        <div id="mic-status" class="mic-status">Click to speak</div>
      </div>

      <!-- Transcription Display -->
      <div class="voice-transcription-wrapper">
        <div class="voice-transcription">
        <h3>Your Recitation:</h3>
        <div id="transcription" class="transcription-text">
          <span class="placeholder">Press the microphone and speak the verse...</span>
        </div>
        <div id="accuracy-display" class="accuracy-display"></div>
        </div>
      </div>

      <!-- Rating and Navigation -->
      <div class="voice-nav">
        <div class="tool-tip-nav">Rate Your Recall:</div>
        <div id="test-buttons" class="score-test-buttons">
          <span class="submit" q="1">1</span>
          <span class="submit" q="2">2</span>
          <span class="submit" q="3">3</span>
          <span class="submit" q="4">4</span>
          <span class="submit" q="5">5</span>
        </div>
        <button id="show-answer" class="toggle-hint">Show Verse</button>
      </div>

      <!-- Hidden Answer -->
      <div id="verse-answer">
        <p class="verse-text"></p>
      </div>

    </div> <!-- end: passage-entry column -->

    <div class="upcoming-passages upcoming">
        <h2>Upcoming Passages</h2>
        <!-- Populated dynamically like /review -->
    </div> <!-- end: upcoming-passages column -->

</div>
</div>

<script>
$(document).ready(function() {

  // ========================================
  // Voice Review State (reuses reviewState patterns)
  // ========================================
  var voiceReviewState = {
    passages: [],           // List of due passages
    currentPassageId: null, // Current passage being reviewed
    currentPassageRef: null,
    passageVerses: [],      // All memverses in current passage
    currentVerseIndex: -1,  // Index of current verse being reviewed
    currentVerse: null,     // Current verse data

    // Initialize - fetch due passages and start
    initialize: function() {
      var self = this;
      $.getJSON('/passages/due.json', function(data) {
        self.passages = data;

        // Build sidebar list (same as reviewState)
        var items = [];
        $.each(data, function(index, passage) {
          items.push('<li class="upcoming-verse-ref white2" id="' + passage.id + '">' + passage.ref + '</li>');
        });
        $('<ul/>', { 'class': 'passage-list', html: items.join('') }).appendTo('.upcoming-passages');

        // Load first passage
        self.autoAdvancePassage();
      });
    },

    // Select and load a passage
    selectPassage: function(passageRef, passageId) {
      var self = this;
      self.currentPassageId = passageId;
      self.currentPassageRef = passageRef;

      // Update passage title
      $('.passage-title').text(passageRef);
      $('.passage-id').text(passageId);

      // Fetch all memverses in passage
      $.getJSON('/passages/' + passageId + '/memverses.json', function(data) {
        // Ensure it's an array
        self.passageVerses = $.isArray(data) ? data : [data];

        // Find first due verse
        self.gotoFirstDueVerse();
      });
    },

    // Find and display the first due verse in the passage
    gotoFirstDueVerse: function() {
      for (var i = 0; i < this.passageVerses.length; i++) {
        if (mvDue(this.passageVerses[i])) {
          this.currentVerseIndex = i;
          this.displayVerse(this.passageVerses[i]);
          return;
        }
      }
      // No due verses in this passage - shouldn't happen but handle it
      this.autoAdvancePassage();
    },

    // Display a verse for voice review
    displayVerse: function(verse) {
      this.currentVerse = verse;

      // Update reference display
      $('.voice-reference .verse-ref').text(verse.ref);
      $('.voice-reference .verse-tl').text('[' + verse.tl + ']');

      // Update hidden answer
      $('#verse-answer .verse-text').text(verse.text);
      $('#verse-answer').removeClass('visible');
      $('#show-answer').text('Show Verse');

      // Reset transcription
      $('#transcription').html('<span class="placeholder">Press the microphone and speak the verse...</span>');
      $('#accuracy-display').text('');
      clearSuggestedRating();

      // Reset recording state
      if (typeof finalTranscript !== 'undefined') {
        finalTranscript = '';
      }
      currentAccuracy = 0;
    },

    // Go to next due verse (same logic as reviewState.gotoNextVerseDue)
    gotoNextVerseDue: function() {
      // Look for next due verse AFTER current
      for (var i = this.currentVerseIndex + 1; i < this.passageVerses.length; i++) {
        if (mvDue(this.passageVerses[i])) {
          this.currentVerseIndex = i;
          this.displayVerse(this.passageVerses[i]);
          return;
        }
      }

      // Check for skipped verses BEFORE current
      for (var i = 0; i < this.currentVerseIndex; i++) {
        if (mvDue(this.passageVerses[i])) {
          this.currentVerseIndex = i;
          this.displayVerse(this.passageVerses[i]);
          return;
        }
      }

      // No more due verses in passage - advance to next passage
      this.autoAdvancePassage();
    },

    // Mark current verse as reviewed (update local state)
    markCurrentVerseReviewed: function() {
      // Set next_test to tomorrow so mvDue returns false
      var tomorrow = new Date();
      tomorrow.setDate(tomorrow.getDate() + 1);
      this.passageVerses[this.currentVerseIndex].next_test = tomorrow.toISOString().split('T')[0];
    },

    // Clear current passage and check if complete
    clearCurrentPassage: function() {
      var passageId = this.currentPassageId;

      if (passageId) {
        // Check if any verses still due
        var stillDue = false;
        for (var i = 0; i < this.passageVerses.length; i++) {
          if (mvDue(this.passageVerses[i])) {
            stillDue = true;
            break;
          }
        }

        if (stillDue) {
          // Move passage to end of list
          $('.passage-list #' + passageId).appendTo('.passage-list').fadeIn();
        } else {
          // Remove from upcoming passages
          $('.passage-list #' + passageId).remove();
        }
      }

      // Reset state
      this.currentPassageId = null;
      this.currentPassageRef = null;
      this.passageVerses = [];
      this.currentVerseIndex = -1;
      this.currentVerse = null;
    },

    // Advance to next passage (same logic as reviewState.autoAdvancePassage)
    autoAdvancePassage: function() {
      this.clearCurrentPassage();

      // Get next passage from list
      var $nextPassage = $('.upcoming-passages').find('.upcoming-verse-ref').first();

      if ($nextPassage.length) {
        $nextPassage.fadeOut('slow');
        this.selectPassage($nextPassage.text(), $nextPassage.attr('id'));
      } else {
        // No more passages - done for the day!
        log_progress('<%= current_user.id %>');
        window.location = '/progress';
      }
    }
  };

  // Current verse reference (for comparison functions)
  var currentVerse = null;

  // Update currentVerse when voiceReviewState changes verse
  var originalDisplayVerse = voiceReviewState.displayVerse;
  voiceReviewState.displayVerse = function(verse) {
    currentVerse = {
      id: verse.id,
      ref: verse.ref,
      text: verse.text
    };
    originalDisplayVerse.call(this, verse);
  };

  // ========================================
  // Configuration
  // ========================================

  // Accuracy threshold for switching display modes:
  // - Below threshold: highlight-only mode (simpler, less visual clutter)
  // - At or above threshold: detailed mode (shows corrections inline)
  var HIGHLIGHT_ONLY_THRESHOLD = 70;

  // Track current accuracy for use across functions
  var currentAccuracy = 0;

  // ========================================
  // Voice Comparison Functions
  // ========================================
  // Note: scrub_text and flexibleTextMatch are provided globally by memverse_lib.js

  // Normalize text for splitting into words
  // - Convert to lowercase
  // - Normalize whitespace (multiple spaces to single space)
  // - Trim leading/trailing whitespace
  // Note: We preserve punctuation here because flexibleTextMatch handles it
  function normalizeText(text) {
    if (!text || typeof text !== 'string') {
      return '';
    }
    return text
      .toLowerCase()
      .replace(/\s+/g, ' ')        // Normalize whitespace
      .trim();
  }

  // Split normalized text into array of words
  function getWordArray(text) {
    if (!text || typeof text !== 'string') {
      return [];
    }
    var normalized = normalizeText(text);
    if (normalized === '') {
      return [];
    }
    return normalized.split(' ');
  }

  // ========================================
  // LCS-based Comparison Algorithm
  // ========================================
  // Uses Longest Common Subsequence (LCS) to find optimal word alignment.
  // This prevents cascading errors when words are omitted.
  // For example, omitting "and sisters" from Romans 12:1 only marks
  // those two words as missing, not the entire rest of the verse.

  // Build LCS table using dynamic programming
  function buildLCSTable(spokenWords, actualWords) {
    var m = spokenWords.length;
    var n = actualWords.length;

    // Create table with (m+1) x (n+1) dimensions, initialized to 0
    var lcs = [];
    for (var i = 0; i <= m; i++) {
      lcs[i] = [];
      for (var j = 0; j <= n; j++) {
        lcs[i][j] = 0;
      }
    }

    // Fill the table using dynamic programming
    for (var i = 1; i <= m; i++) {
      for (var j = 1; j <= n; j++) {
        if (flexibleTextMatch(actualWords[j - 1], spokenWords[i - 1])) {
          // Words match - extend the subsequence
          lcs[i][j] = lcs[i - 1][j - 1] + 1;
        } else {
          // Words don't match - take the max from excluding either word
          lcs[i][j] = Math.max(lcs[i - 1][j], lcs[i][j - 1]);
        }
      }
    }

    return lcs;
  }

  // Align spoken words to actual verse using suffix LCS table for optimal decisions.
  // This handles both repeated phrases (prefers earlier matches) and wrong words
  // (marks as extra without cascading errors).
  function greedyAlign(spokenWords, actualWords) {
    var m = spokenWords.length;
    var n = actualWords.length;

    // Build suffix LCS table: suffixLcs[i][j] = LCS length of spoken[i:] and actual[j:]
    var suffixLcs = [];
    for (var x = 0; x <= m; x++) {
      suffixLcs[x] = [];
      for (var y = 0; y <= n; y++) {
        suffixLcs[x][y] = 0;
      }
    }

    // Fill table from bottom-right to top-left
    for (var i = m - 1; i >= 0; i--) {
      for (var j = n - 1; j >= 0; j--) {
        if (flexibleTextMatch(actualWords[j], spokenWords[i])) {
          suffixLcs[i][j] = suffixLcs[i + 1][j + 1] + 1;
        } else {
          suffixLcs[i][j] = Math.max(suffixLcs[i + 1][j], suffixLcs[i][j + 1]);
        }
      }
    }

    // Forward alignment using suffix LCS to guide decisions
    var alignment = [];
    var si = 0; // spoken index
    var ai = 0; // actual index

    while (si < m && ai < n) {
      if (flexibleTextMatch(actualWords[ai], spokenWords[si])) {
        // Words match - take the match
        alignment.push({ type: 'match', spokenIdx: si, actualIdx: ai });
        si++;
        ai++;
      } else {
        // Words don't match - decide whether to skip spoken or actual
        // Compare future LCS: which skip leads to better alignment?
        var skipSpokenFutureLcs = suffixLcs[si + 1][ai];
        var skipActualFutureLcs = suffixLcs[si][ai + 1];

        if (skipSpokenFutureLcs > skipActualFutureLcs) {
          // Skipping spoken word leads to better alignment - mark spoken as extra
          alignment.push({ type: 'extra', spokenIdx: si });
          si++;
        } else if (skipActualFutureLcs > skipSpokenFutureLcs) {
          // Skipping actual word leads to better alignment - mark actual as missing
          alignment.push({ type: 'missing', actualIdx: ai });
          ai++;
        } else {
          // Tie: prefer marking spoken as extra (user made mistake)
          alignment.push({ type: 'extra', spokenIdx: si });
          si++;
        }
      }
    }

    // Handle remaining spoken words (extras)
    while (si < m) {
      alignment.push({ type: 'extra', spokenIdx: si });
      si++;
    }

    // Handle remaining actual words (missing)
    while (ai < n) {
      alignment.push({ type: 'missing', actualIdx: ai });
      ai++;
    }

    return alignment;
  }

  // Compare spoken words to actual verse words using greedy sequential alignment
  // Each result item includes actualIdx (verse position) for proper filtering
  function compareVerses(spokenWords, actualWords) {
    var result = [];

    // Handle empty cases
    if (!actualWords || actualWords.length === 0) {
      if (spokenWords && spokenWords.length > 0) {
        spokenWords.forEach(function(word) {
          result.push({ word: word, status: 'extra', actualIdx: -1 });
        });
      }
      return result;
    }

    if (!spokenWords || spokenWords.length === 0) {
      actualWords.forEach(function(word, idx) {
        result.push({ word: word, status: 'missing', actualIdx: idx });
      });
      return result;
    }

    // Use greedy alignment to prefer earliest matches for repeated words
    var alignment = greedyAlign(spokenWords, actualWords);

    // Convert alignment to comparison result, detecting substitutions
    // Track actualIdx (verse position) for each word
    var i = 0;
    while (i < alignment.length) {
      var op = alignment[i];

      // Check for extra followed by missing (substitution pattern)
      if (op.type === 'extra' && i + 1 < alignment.length && alignment[i + 1].type === 'missing') {
        result.push({
          word: spokenWords[op.spokenIdx],
          status: 'wrong',
          expected: actualWords[alignment[i + 1].actualIdx],
          actualIdx: alignment[i + 1].actualIdx  // Track verse position of substituted word
        });
        i += 2; // Skip both the extra and the missing
        continue;
      }

      // Check for missing followed by extra (substitution pattern)
      if (op.type === 'missing' && i + 1 < alignment.length && alignment[i + 1].type === 'extra') {
        result.push({
          word: spokenWords[alignment[i + 1].spokenIdx],
          status: 'wrong',
          expected: actualWords[op.actualIdx],
          actualIdx: op.actualIdx  // Track verse position of substituted word
        });
        i += 2; // Skip both the missing and the extra
        continue;
      }

      // Not a substitution - process normally
      switch (op.type) {
        case 'match':
          result.push({ word: spokenWords[op.spokenIdx], status: 'correct', actualIdx: op.actualIdx });
          break;
        case 'missing':
          result.push({ word: actualWords[op.actualIdx], status: 'missing', actualIdx: op.actualIdx });
          break;
        case 'extra':
          result.push({ word: spokenWords[op.spokenIdx], status: 'extra', actualIdx: -1 });
          break;
      }
      i++;
    }

    return result;
  }

  // Calculate accuracy percentage
  function calculateAccuracy(comparisonResult, totalExpectedWords) {
    if (!comparisonResult || comparisonResult.length === 0 || totalExpectedWords === 0) {
      return 0;
    }
    var correctWords = comparisonResult.filter(function(item) {
      return item.status === 'correct';
    }).length;
    var accuracy = (correctWords / totalExpectedWords) * 100;
    return Math.round(accuracy * 100) / 100;
  }

  // Get suggested rating based on accuracy
  function getSuggestedRating(accuracy) {
    if (accuracy >= 95) return 5;
    if (accuracy >= 85) return 4;
    if (accuracy >= 70) return 3;
    if (accuracy >= 50) return 2;
    return 1;
  }

  // Filter out trailing missing words from comparison result
  // During real-time recitation, we don't want to show missing words
  // that come AFTER the user's current position in the verse.
  //
  // IMPORTANT: We filter based on VERSE POSITION (actualIdx), not array position.
  // This handles cases where repeated phrases cause LCS to match later occurrences,
  // which would otherwise show many "missing" words in the middle.
  //
  // Example: If verse has "walk in it" twice and user says "walking in it",
  // LCS might match "in it" to the second occurrence. Without verse-position
  // filtering, all words between the two occurrences would appear as "missing".
  function filterTrailingMissing(comparisonResult) {
    if (!comparisonResult || comparisonResult.length === 0) {
      return [];
    }

    // Find the maximum verse position (actualIdx) among spoken words (correct or wrong)
    // This represents how far the user has progressed in the verse
    var maxSpokenVersePosition = -1;
    var hasExtraWords = false;

    for (var i = 0; i < comparisonResult.length; i++) {
      var item = comparisonResult[i];
      // Only consider words that have a verse position (correct, wrong, missing)
      // and that represent user speech (correct, wrong - not missing)
      if ((item.status === 'correct' || item.status === 'wrong') && item.actualIdx !== undefined) {
        maxSpokenVersePosition = Math.max(maxSpokenVersePosition, item.actualIdx);
      }
      // Track if there are any extra words (user said something not in verse)
      if (item.status === 'extra') {
        hasExtraWords = true;
      }
    }

    // If no spoken words with verse positions found but there are extra words,
    // return only the extra words (user said something, just nothing that matches the verse)
    if (maxSpokenVersePosition === -1) {
      if (hasExtraWords) {
        return comparisonResult.filter(function(item) { return item.status === 'extra'; });
      }
      return [];
    }

    // Filter: keep words that are at or before the user's current verse position
    // This removes "missing" words that are beyond where the user has reached
    return comparisonResult.filter(function(item) {
      // Extra words (spoken but not in verse) have no verse position - always keep
      if (item.actualIdx === undefined || item.actualIdx === -1) {
        return true;
      }
      // Keep words at or before the user's current position in the verse
      return item.actualIdx <= maxSpokenVersePosition;
    });
  }

  // Escape HTML special characters
  function escapeHtml(text) {
    var div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
  }

  // Render comparison result as HTML
  function renderComparison(comparisonResult) {
    if (!comparisonResult || comparisonResult.length === 0) {
      return '';
    }

    var htmlParts = comparisonResult.map(function(item) {
      var word = item.word;
      var status = item.status;
      var expected = item.expected;

      switch (status) {
        case 'correct':
          return '<span class="word-correct">' + escapeHtml(word) + '</span>';
        case 'wrong':
          return '<span class="word-wrong">' + escapeHtml(word) + '</span><span class="word-expected">' + escapeHtml(expected) + '</span>';
        case 'missing':
          return '<span class="word-missing">' + escapeHtml(word) + '</span>';
        case 'extra':
          return '<span class="word-extra">' + escapeHtml(word) + '</span>';
        default:
          return '<span>' + escapeHtml(word) + '</span>';
      }
    });

    return htmlParts.join(' ');
  }

  // Render comparison in highlight-only mode (for low accuracy)
  // Only shows spoken words with errors highlighted - no inline corrections
  function renderComparisonHighlightOnly(comparisonResult) {
    if (!comparisonResult || comparisonResult.length === 0) {
      return '';
    }

    var htmlParts = comparisonResult
      .filter(function(item) { return item.status !== 'missing'; }) // Only show spoken words
      .map(function(item) {
        var word = item.word;
        var status = item.status;

        switch (status) {
          case 'correct':
            return '<span class="word-correct">' + escapeHtml(word) + '</span>';
          case 'wrong':
          case 'extra':
            // Highlight errors with subtle background, no strikethrough or corrections
            return '<span class="word-error">' + escapeHtml(word) + '</span>';
          default:
            return '<span>' + escapeHtml(word) + '</span>';
        }
      });

    return htmlParts.join(' ');
  }

  // Update the display with comparison results
  // confirmedText: text that has been finalized by speech recognition (stable)
  // interimText: text that is still being processed (may change rapidly)
  // isFinal: when true, calculates accuracy against total expected words (for final score)
  //          when false, calculates accuracy against words spoken so far (for real-time feedback)
  function updateComparison(confirmedText, interimText, isFinal) {
    var confirmedWords = getWordArray(confirmedText);
    var actualWords = getWordArray(currentVerse.text);

    // Show placeholder if nothing spoken yet
    if (confirmedWords.length === 0 && (!interimText || interimText.trim() === '')) {
      $('#transcription').html('<span class="placeholder">Press the microphone and speak the verse...</span>');
      $('#accuracy-display').text('');
      clearSuggestedRating();
      return;
    }

    var html = '';
    var accuracy = 0;

    // Only compare confirmed (final) words to avoid flicker from unstable interim results
    if (confirmedWords.length > 0) {
      var comparison = compareVerses(confirmedWords, actualWords);

      // Filter out trailing missing words for display
      // (We only show words the user has actually spoken, plus any skipped words in the middle)
      var filteredComparison = filterTrailingMissing(comparison);

      // Calculate accuracy
      var correctCount = filteredComparison.filter(function(item) {
        return item.status === 'correct';
      }).length;

      if (isFinal) {
        // Final accuracy: correct words / total expected words in verse
        // This penalizes omitting words at the end
        accuracy = actualWords.length > 0 ? Math.round((correctCount / actualWords.length) * 100 * 100) / 100 : 0;
      } else {
        // Real-time accuracy: correct words / words spoken so far
        // This gives encouraging feedback during recitation
        var spokenWordCount = filteredComparison.filter(function(item) {
          return item.status !== 'missing';
        }).length;
        accuracy = spokenWordCount > 0 ? Math.round((correctCount / spokenWordCount) * 100 * 100) / 100 : 0;
      }

      // Choose render mode based on accuracy threshold
      // Low accuracy: highlight-only mode (less visual clutter)
      // High accuracy: detailed mode (shows corrections inline)
      var useHighlightOnly = accuracy < HIGHLIGHT_ONLY_THRESHOLD;
      html = useHighlightOnly
        ? renderComparisonHighlightOnly(filteredComparison)
        : renderComparison(filteredComparison);
    }

    // Append interim text (not yet confirmed) in gray without comparison styling
    // This shows what's being heard without causing flicker from unstable comparisons
    if (interimText && interimText.trim() !== '') {
      html += '<span class="interim">' + escapeHtml(interimText) + '</span>';
    }

    $('#transcription').html(html);

    var rating = getSuggestedRating(accuracy);

    // Store accuracy for use in other functions (e.g., auto-show verse on recording end)
    currentAccuracy = accuracy;

    // Show accuracy (only if we have confirmed words)
    if (confirmedWords.length > 0) {
      $('#accuracy-display').text('Accuracy: ' + accuracy + '%');
      highlightSuggestedRating(rating);
    } else {
      $('#accuracy-display').text('');
      clearSuggestedRating();
    }
  }

  // Highlight the suggested rating button
  function highlightSuggestedRating(rating) {
    $('.score-test-buttons .submit').removeClass('rating-suggested');
    $('.score-test-buttons .submit[q="' + rating + '"]').addClass('rating-suggested');
  }

  // Clear suggested rating highlight
  function clearSuggestedRating() {
    $('.score-test-buttons .submit').removeClass('rating-suggested');
  }

  // ========================================
  // Web Speech API Setup
  // ========================================

  var SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;

  if (!SpeechRecognition) {
    $('#mic-button').prop('disabled', true);
    $('#mic-status').text('Speech recognition not supported in this browser. Please use Chrome or Edge.');
  } else {
    var recognition = new SpeechRecognition();
    recognition.continuous = true;
    recognition.interimResults = true;
    recognition.lang = 'en-US';

    var isRecording = false;
    var finalTranscript = '';

    // Microphone button click
    $('#mic-button').click(function() {
      if (isRecording) {
        recognition.stop();
      } else {
        finalTranscript = '';
        $('#transcription').html('');
        $('#accuracy-display').text('');
        clearSuggestedRating();
        recognition.start();
      }
    });

    // Recognition started
    recognition.onstart = function() {
      isRecording = true;
      $('#mic-button').addClass('recording');
      $('#mic-status').text('Listening... (click to stop)');
    };

    // Recognition ended
    recognition.onend = function() {
      isRecording = false;
      $('#mic-button').removeClass('recording');
      $('#mic-status').text('Click to speak');

      // Final comparison when recording ends - use isFinal=true for accuracy against total verse
      if (finalTranscript.trim()) {
        updateComparison(finalTranscript, '', true);

        // Auto-show the correct verse when accuracy is below threshold
        // This helps users see what they missed without extra clicks
        if (currentAccuracy < HIGHLIGHT_ONLY_THRESHOLD && !$('#verse-answer').hasClass('visible')) {
          $('#verse-answer').addClass('visible');
          $('#show-answer').text('Hide Verse');
        }
      }
    };

    // Recognition results - real-time comparison
    recognition.onresult = function(event) {
      var interimTranscript = '';

      for (var i = event.resultIndex; i < event.results.length; i++) {
        var transcript = event.results[i][0].transcript;
        if (event.results[i].isFinal) {
          finalTranscript += transcript + ' ';
        } else {
          interimTranscript += transcript;
        }
      }

      // Compare only confirmed words; show interim separately to avoid flicker
      updateComparison(finalTranscript, interimTranscript, false);
    };

    // Recognition error
    recognition.onerror = function(event) {
      $('#mic-status').text('Error: ' + event.error);
      if (event.error === 'not-allowed') {
        $('#mic-status').text('Microphone access denied. Please allow microphone access.');
      }
    };
  }

  // Show/hide answer
  $('#show-answer').click(function() {
    $('#verse-answer').toggleClass('visible');
    $(this).text($('#verse-answer').hasClass('visible') ? 'Hide Verse' : 'Show Verse');
  });

  // Rating button click - submit rating and go to next verse
  $('.score-test-buttons .submit').click(function() {
    var q = $(this).attr('q');

    if (!currentVerse || !currentVerse.id) {
      console.error('No current verse to rate');
      return;
    }

    // Submit the rating
    $.getJSON("/mark_test_quick", { mv: currentVerse.id, q: q })
      .done(function(data) {
        if (data.msg) {
          setTimeout(function() { alert(data.msg); }, 1);
        }
        // Mark verse as reviewed locally and advance to next
        voiceReviewState.markCurrentVerseReviewed();
        voiceReviewState.gotoNextVerseDue();
      })
      .fail(function(jqXHR, textStatus, errorThrown) {
        console.error('Rating submission failed:', textStatus, errorThrown);
        alert('Failed to submit rating. Please try again.');
      });
  });

  // Allow clicking on upcoming passages to switch (same as /review)
  $('.upcoming-passages').on('click', '.upcoming-verse-ref', function(e) {
    $(this).fadeOut();
    voiceReviewState.clearCurrentPassage();
    voiceReviewState.selectPassage($(this).text(), $(this).attr('id'));
  });

  // Initialize voice review state
  voiceReviewState.initialize();
});
</script>
