<% page_title @verse.ref_long %>
<% owner = @mv.user_id == current_user.id %>
<main class="verse-detail" aria-labelledby="verse-reference">
  <%= link_to manage_verses_path, class: 'verse-back' do %>
    <span aria-hidden="true">←</span> Back to my verses
  <% end %>
  <article class="verse-folio">
    <div class="verse-reading">
      <div class="verse-version">
        <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5.5C9 3.4 5.4 3.3 2.5 4.3v14c3.1-1.1 6.5-.8 9.5 1.2 3-2 6.4-2.3 9.5-1.2v-14c-2.9-1-6.5-.9-9.5 1.2Zm0 0v14"/></svg>
        <%= Translation.find(@verse.translation)&.dig(:name) || @verse.translation %>
      </div>
      <h1 id="verse-reference"><%= @verse.ref_long %></h1>
      <div class="verse-rule" aria-hidden="true"><i></i></div>
      <p class="verse-scripture"><%= heritage_scripture_text(@verse.text) %></p>
    </div>
    <% if @prev_mv || @next_mv %>
      <nav class="verse-neighbors" aria-label="Adjacent memory verses">
        <% if @prev_mv %>
          <%= link_to memory_verse_path(@prev_mv), rel: 'prev' do %>
            <span aria-hidden="true">←</span><span><small>Previous verse</small><strong><%= @prev_mv.verse.ref_long %></strong></span>
          <% end %>
        <% end %>
        <% if @next_mv %>
          <%= link_to memory_verse_path(@next_mv), rel: 'next' do %>
            <span><small>Next verse</small><strong><%= @next_mv.verse.ref_long %></strong></span><span aria-hidden="true">→</span>
          <% end %>
        <% end %>
      </nav>
    <% end %>
  </article>

  <div class="verse-panels">
    <section class="verse-panel" id="review-schedule" aria-labelledby="review-schedule-title">
      <h2 id="review-schedule-title"><svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M7 3v5m10-5v5M3 11h18"/></svg>Review schedule</h2>
      <div class="verse-status">
        <span class="verse-pill" data-status="<%= @mv.status %>"><%= @mv.status %></span>
        <% if owner %>
          <%= button_to toggle_mv_status_path(@mv), params: { review_state: @mv.inactive? ? 'active' : 'paused' }, class: 'verse-action' do %>
            <span aria-hidden="true"><%= @mv.inactive? ? '▷' : 'Ⅱ' %></span><%= @mv.inactive? ? 'Resume reviews' : 'Pause reviews' %>
          <% end %>
        <% end %>
      </div>
      <dl class="verse-metrics">
        <div><dt>Last tested</dt><dd><%= @mv.last_tested&.strftime('%b %-d, %Y') || 'Never' %></dd></div>
        <div><dt>Next test</dt><dd><%= (@mv.next_test&.strftime('%b %-d, %Y') unless @mv.inactive?) || 'Unscheduled' %></dd></div>
        <div><dt>Interval</dt><dd><%= pluralize(@mv.test_interval, 'day') %></dd></div>
        <div><dt>Difficulty</dt><dd><%= number_with_precision(@mv.efactor, precision: 2) || '—' %></dd></div>
      </dl>
    </section>
    <%= render 'detail_tags', owner: owner %>
  </div>
</main>
