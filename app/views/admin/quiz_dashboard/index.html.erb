<% page_title "Quiz Admin Dashboard" %>

<div class="container mx-auto px-4 py-8">
  <div class="flex justify-between items-center mb-8">
    <h1 class="text-3xl font-bold">Quiz Management Dashboard</h1>
    <%= link_to "Create New Quiz", new_admin_quiz_dashboard_path, 
                class: "bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700" %>
  </div>

  <!-- System Health Status -->
  <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-8">
    <% @system_health.each do |component, status| %>
      <div class="bg-white rounded-lg shadow p-4">
        <h3 class="font-semibold text-gray-700 mb-2"><%= component.to_s.humanize %></h3>
        <% if status == true || (status.is_a?(Hash) && !status[:error]) %>
          <div class="flex items-center text-green-600">
            <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
            </svg>
            <span>Operational</span>
          </div>
        <% else %>
          <div class="flex items-center text-red-600">
            <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
            </svg>
            <span>Error</span>
          </div>
          <% if status.is_a?(Hash) && status[:error] %>
            <p class="text-xs text-gray-600 mt-1"><%= status[:error] %></p>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>

  <!-- Live Quizzes -->
  <% if @live_quizzes.any? %>
    <div class="bg-yellow-50 border-l-4 border-yellow-400 p-4 mb-8">
      <div class="flex">
        <div class="flex-shrink-0">
          <svg class="h-5 w-5 text-yellow-400" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
          </svg>
        </div>
        <div class="ml-3">
          <h3 class="text-sm font-medium text-yellow-800">Live Quizzes in Progress</h3>
          <div class="mt-2 text-sm text-yellow-700">
            <ul class="list-disc list-inside">
              <% @live_quizzes.each do |quiz| %>
                <li>
                  <%= link_to quiz.name, monitor_admin_quiz_dashboard_path(quiz), 
                              class: "underline hover:text-yellow-900" %>
                  - Started <%= time_ago_in_words(quiz.start_time) %> ago
                  <%= link_to "Monitor", monitor_admin_quiz_dashboard_path(quiz), 
                              class: "ml-2 text-xs bg-yellow-600 text-white px-2 py-1 rounded" %>
                  <%= link_to "Stop", stop_admin_quiz_dashboard_path(quiz), 
                              method: :post,
                              data: { confirm: "Are you sure you want to stop this quiz?" },
                              class: "ml-1 text-xs bg-red-600 text-white px-2 py-1 rounded" %>
                </li>
              <% end %>
            </ul>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <!-- Upcoming Quizzes -->
  <div class="mb-8">
    <h2 class="text-xl font-semibold mb-4">Upcoming Quizzes (Next 24 Hours)</h2>
    <% if @upcoming_quizzes.any? %>
      <div class="bg-white rounded-lg shadow overflow-hidden">
        <table class="min-w-full">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Name</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Start Time</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Questions</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Creator</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <% @upcoming_quizzes.each do |quiz| %>
              <tr>
                <td class="px-6 py-4 whitespace-nowrap">
                  <%= link_to quiz.name, admin_quiz_dashboard_path(quiz), 
                              class: "text-blue-600 hover:underline" %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <%= quiz.start_time.strftime("%b %d, %I:%M %p %Z") %>
                  <span class="text-xs text-gray-500 block">
                    (<%= time_ago_in_words(quiz.start_time) %> from now)
                  </span>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <%= quiz.quiz_questions.count %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <%= quiz.user.name_or_login %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm">
                  <%= link_to "Start Now", start_admin_quiz_dashboard_path(quiz), 
                              method: :post,
                              class: "text-green-600 hover:text-green-900 mr-2" %>
                  <%= link_to "Edit", edit_quiz_path(quiz), 
                              class: "text-blue-600 hover:text-blue-900 mr-2" %>
                  <%= link_to "Cancel", admin_quiz_dashboard_path(quiz), 
                              method: :delete,
                              data: { confirm: "Are you sure?" },
                              class: "text-red-600 hover:text-red-900" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="text-gray-600">No upcoming quizzes scheduled in the next 24 hours.</p>
    <% end %>
  </div>

  <!-- All Quizzes -->
  <div>
    <h2 class="text-xl font-semibold mb-4">All Quizzes</h2>
    <div class="bg-white rounded-lg shadow overflow-hidden">
      <table class="min-w-full">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">ID</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Name</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Start Time</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Questions</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% @quizzes.each do |quiz| %>
            <tr>
              <td class="px-6 py-4 whitespace-nowrap text-sm">
                #<%= quiz.id %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <%= link_to quiz.name, admin_quiz_dashboard_path(quiz), 
                            class: "text-blue-600 hover:underline" %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <% if quiz.start_time && quiz.start_time < Time.current %>
                  <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-gray-100 text-gray-800">
                    Completed
                  </span>
                <% elsif quiz.start_time && quiz.start_time > Time.current %>
                  <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-blue-100 text-blue-800">
                    Scheduled
                  </span>
                <% else %>
                  <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-yellow-100 text-yellow-800">
                    Draft
                  </span>
                <% end %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm">
                <%= quiz.start_time&.strftime("%b %d, %Y %I:%M %p") || "Not scheduled" %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm">
                <%= quiz.quiz_questions.count %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm">
                <div class="flex space-x-2">
                  <%= link_to "View", admin_quiz_dashboard_path(quiz), 
                              class: "text-blue-600 hover:text-blue-900" %>
                  <%= link_to "Monitor", monitor_admin_quiz_dashboard_path(quiz), 
                              class: "text-green-600 hover:text-green-900" %>
                  <%= link_to "Participants", participants_admin_quiz_dashboard_path(quiz), 
                              class: "text-purple-600 hover:text-purple-900" %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
      
      <div class="bg-white px-4 py-3 border-t border-gray-200 sm:px-6">
        <%= paginate @quizzes %>
      </div>
    </div>
  </div>

  <!-- Quick Actions -->
  <div class="mt-8 flex space-x-4">
    <%= link_to "View Schedule", schedule_admin_quiz_dashboards_path, 
                class: "bg-gray-600 text-white px-4 py-2 rounded hover:bg-gray-700" %>
    <%= link_to "Statistics", statistics_admin_quiz_dashboards_path, 
                class: "bg-purple-600 text-white px-4 py-2 rounded hover:bg-purple-700" %>
    <%= link_to "Error Logs", error_logs_admin_quiz_dashboards_path, 
                class: "bg-red-600 text-white px-4 py-2 rounded hover:bg-red-700" %>
    <%= link_to "Health Check", health_check_admin_quiz_dashboards_path, 
                class: "bg-green-600 text-white px-4 py-2 rounded hover:bg-green-700" %>
  </div>
</div>