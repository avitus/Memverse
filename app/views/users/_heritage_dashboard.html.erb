<% page_title @user == current_user ? 'My dashboard' : @user.name_or_login %>
<div class="heritage-page-heading"><div><span class="heritage-eyebrow">Scripture by heart</span><h1><%= @user == current_user ? 'Welcome back, ' + @user.name_or_login + '.' : @user.name_or_login %></h1><p class="heritage-muted">A little practice. A lasting treasure.</p></div><% if @user == current_user %><%= link_to 'Begin review →', passage_review_path, class: 'heritage-primary' %><% end %></div>
<div class="heritage-stats heritage-stats-four"><div class="heritage-stat">Memorized<strong><%= @user.memorized %></strong><small><%= @user.learning %> learning · <%= @user.pending.count %> paused</small></div><div class="heritage-stat">Level<strong><%= @user.level %></strong><small><%= @user.completed_sessions %> completed sessions</small></div><div class="heritage-stat">Reference recall<strong><%= @user.ref_grade %>%</strong><small>Matching words to their reference</small></div><div class="heritage-stat">Accuracy<strong><%= @user.accuracy %>%</strong><small><%= @user.work_load %> min estimated daily review</small></div></div>
<section class="white-box-with-margins heritage-awards-showcase"><span class="heritage-eyebrow">Dedication deserves a little celebration</span><%= render 'quests/badges' %></section>
<div class="heritage-dashboard-grid">
<section class="white-box-with-margins"><h2>Verse distribution</h2><div class="heritage-tabs" role="group" aria-label="Verse distribution"><button type="button" data-distribution="testament" aria-pressed="true">Testament</button><button type="button" data-distribution="genre" aria-pressed="false">Genre</button></div>
<% {testament: [[:ot,'Old Testament'],[:nt,'New Testament']], genre: [[:history,'History'],[:wisdom,'Wisdom'],[:prophecy,'Prophecy'],[:gospel,'Gospels'],[:epistle,'Epistles']]}.each do |group, categories| %><div data-distribution-panel="<%= group %>" <%= 'hidden' if group == :genre %>><table class="memverse-standard"><thead><tr><th scope="col">Category</th><th scope="col">Memorized</th><th scope="col">Learning</th><th scope="col">Share</th></tr></thead><tbody><% categories.each do |key,label| %><tr><th scope="row"><%= label %></th><td><%= @user.category_verses(key)['Memorized'] %></td><td><%= @user.category_verses(key)['Learning'] %></td><td><%= @user.category_perc(key) %>%</td></tr><% end %></tbody></table></div><% end %>
</section>
<section class="white-box-with-margins"><h2>Complete chapters</h2><% if @user.complete_chapters.empty? %><p class="heritage-muted">Keep practicing. Your complete chapters will appear here.</p><% else %><label for="heritage-chapter-search">Find a chapter</label><input type="search" id="heritage-chapter-search" placeholder="Search chapters"><table class="memverse-standard" id="heritage-chapters"><thead><tr><th>Chapter</th><th>Translation</th></tr></thead><tbody><% @user.complete_chapters.each do |chapter| %><tr><td><%= chapter[1] %></td><td><%= chapter[0] %></td></tr><% end %></tbody></table><% end %></section>
<% if @user == current_user %><section class="white-box-with-margins"><div id="quest-info"><%= render 'quests/current_user_quests', completed: @current_completed_quests, current_user_quests: @current_user_quests %></div></section><% end %>
<details class="white-box-with-margins"><summary>Account details</summary><p>Member since <%= @user.created_at.to_date %></p><p><%= @user.country&.printable_name %><% if @user.american_state %> · <%= @user.american_state.name %><% end %></p><p>Language: <%= @user.language %></p><% if @user.church %><p>Church: <%= link_to @user.church.name, controller: 'church', action: 'show', id: @user.church.id %></p><% end %><% if @user.show_email? %><p><%= @user.email %></p><% end %><% if @user == current_user %><%= link_to 'Edit profile', update_profile_path %><% end %></details>
</div>
