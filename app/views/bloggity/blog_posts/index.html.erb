<%= page_title I18n.t('menu.blog') %>

<!-- Namespace for Bloggity styles -->
<% content_for :body_css do %>id='bloggity_container'<% end -%>

<% if heritage_enabled? %>
  <% category = Bloggity::BlogCategory.find_by(id: params[:category_id]) if params[:category_id].present? %>
  <% heading = if params[:tag_name].present?
    "Articles tagged “#{params[:tag_name]}”."
  elsif category
    category.name
  elsif params[:page].to_i > 1
    'From the archives.'
  else
    'Words for the journey.'
  end %>
  <div class="heritage-page-heading"><div><span class="heritage-eyebrow">The Memverse journal</span><h1><%= heading %></h1><p>Scripture, stories, and a life of remembering.</p></div><%= link_to 'Search the journal', blog_search_path, class: 'heritage-secondary' %></div>
<% end %>
<div id="main_content">

	<%= flash[:error] %>
	<%= flash[:message] %>

	<% cache(["Blog-canvas-v2", heritage_enabled?, blog_logged_in? && current_user.can_blog?(@blog_id), params[:tag_name], params[:category_id], params[:page] ], :expires_in => 5.minutes) do %>

		<!-- Create new post -->
		<% if blog_logged_in? && current_user.can_blog?(@blog_id) %>
			<%= link_to "New blog post", { :controller => 'blog_posts', :action => :new, :blog_id => @blog_id } %>
			or <%= link_to "see pending posts", { :controller => 'blog_posts', :action => 'pending', :blog_id => @blog_id } %>
		<% end %>

		<!-- Filter by tags -->
		<% unless params[:tag_name].blank? %>
			<div>Filtering all blogs tagged as "<%= params[:tag_name] -%>."  <%= link_to "Clear filter", blog_named_link(nil, :index, { :blog => @blog }) -%></div>
		<% end %>

		<!-- Filter by category -->
		<% if !params[:category_id].blank? && (cat = Bloggity::BlogCategory.find_by(id: params[:category_id])) %>
			<div>Filtering all blogs in category "<%= cat.name -%>."  <%= link_to "Clear filter", blog_named_link(nil, :index, { :blog => @blog }) -%></div>
		<% end %>

		<!-- Beacon Ads Zone Code -->
		<div id="bsap_1270635" class="bsarocks bsap_e48f1701bd375546050e63082dc7a164"></div>
		<!-- End Beacon Ads Zone Code -->

		<% if heritage_enabled? && @blog_posts.blank? %><p>No articles found. <%= link_to 'Browse all articles', blog_named_link(nil, :index, {blog: @blog}) %></p><% end %>
        <!-- Show each post -->
		<% for blog_post in @blog_posts %>
			<%= render :partial => 'bloggity/blog_posts/show', :locals => { :blog_post => blog_post, :header_style => 'h2', :show_comment_count => true } %>
		<% end %>

		<!-- Pagination -->
		<% if @blog_posts %>
			<br>
			<div class="paginate_container"><%= paginate @blog_posts %></div>
		<% end %>

	<% end %>
</div>

<!-- Right side navigation -->
<%= render :partial => 'bloggity/blog_posts/side_nav' %>
