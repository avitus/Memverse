<%# Renders a blog post
# -params-
# blog_post: the blog post
# header_style (optional): 'h1', 'h2', etc.
# show_comment_count (optional): true or false
-%>

<% header_style ||= 'h1'
   show_comment_count ||= false %>

<div class="one_blog">

	<<%= header_style %> style="margin-bottom:0px"><%= link_to(blog_post.title, blog_named_link(blog_post)) %></<%= header_style %>>

<div class="info"><time datetime="<%= blog_post.created_at.iso8601 %>"><%= blog_post.created_at.strftime('%B %d, %Y') %></time> · <%= blog_post.posted_by ? link_to(blog_post.posted_by.display_name, [main_app, blog_post.posted_by]) : 'Unknown author' %><% if show_comment_count %> · <%= link_to pluralize(blog_post.approved_comments.size, 'comment'), blog_named_link(blog_post) + '#comments' %><% end %></div>

	<br />

	<% if heritage_enabled? && show_comment_count %>
        <p><%= truncate(strip_tags(blog_post.body), length: 260) %></p>
        <%= link_to "Read article →", blog_named_link(blog_post) %>
    <% elsif blog_post.fck_created %>
		<%= sanitize(blog_post.body) -%>
	<% else %>
		<%= simple_format(Rinku.auto_link(blog_post.body)) %>
	<% end %>

	<!--
	<script src="http://connect.facebook.net/en_US/all.js#xfbml=1"></script><fb:like show_faces="true" width="450"></fb:like>
	-->

	<% unless heritage_enabled? %>
    <!-- AddThis Button BEGIN -->
	<div class="addthis_toolbox addthis_default_style ">
	    <a class="addthis_button_preferred_1"></a>
	    <a class="addthis_button_preferred_2"></a>
	    <a class="addthis_button_preferred_3"></a>
	</div>
	<script type="text/javascript">var addthis_config = {"data_track_clickback":true};</script>
	<script type="text/javascript" src="https://s7.addthis.com/js/250/addthis_widget.js#pubid=ra-4d6dc48d2a620dab"></script>
	<!-- AddThis Button END -->
    <% end %>

	<% if blog_post.category %>
		<br />
		<%= image_tag "bloggity/cat.gif" -%> <%= link_to strip_tags(blog_post.category.name), {:controller => 'blog_posts', :action => :index, :blog_id => blog_post.blog_id, :category_id => blog_post.category_id} %>
	<% end %>

	<% unless blog_post.tags.blank? %>
		<br />
		<%= image_tag "bloggity/tag.gif" -%> <%= safe_join(blog_post.tags.collect { |t| link_to(strip_tags(t.name), {:controller => 'blog_posts', :action => :index, :blog_id => blog_post.blog_id}.merge(:tag_name => t.name)) }, ", ") %>
	<% end %>

	<% if blog_logged_in? && (current_user.can_blog?(@blog_id) || current_user.can_moderate_blog_comments?(@blog_id)) %>
		<% actions = []
		actions << link_to('Edit', blog_named_link(blog_post, :edit)) if current_user.can_blog?(@blog_id)
		actions << link_to('Destroy', blog_named_link(blog_post, :destroy), :confirm => 'Are you sure?', :method => :delete) if current_user.can_blog?(@blog_id)
		actions << link_to('Close commenting', blog_named_link(blog_post, :close), :confirm => 'Are you sure?') if current_user.can_moderate_blog_comments?(@blog_id) && !blog_post.comments_closed?
		%>
		<div class="clr"></div>
		<br />
		<%= safe_join(actions, " or ") -%>
	<% end %>
</div>
