<% if heritage_enabled? %>
<div class="heritage-search-results"><% if @blog_search_results.empty? %><h2>No articles found.</h2><p>Try a different word or <%= link_to 'browse all articles', bloggity.root_path %>.</p><% else %><p class="heritage-muted"><%= pluralize(@blog_search_results.length, 'article') %> found</p><% @blog_search_results.each do |blog_post| %><%= render 'bloggity/blog_posts/show', blog_post: blog_post, header_style: 'h2', show_comment_count: true %><% end %><% end %></div>
<% else %>
<% if !@blog_search_results.empty? %>
	<div id="main_content">
		<table id="pending_blog_list"><tr id="header"><td>Blog Title</td><td>Author</td><td>Created on</td></tr>
		<% @blog_search_results.each do |blog_post| %>
			<tr>
				<td><%= link_to blog_post.title, blog_named_link(blog_post, :show) %></td>
				<td><%= blog_post.posted_by.display_name -%></td>
				<td><%= blog_post.created_at.strftime("%x") -%></td>
			</tr>
		<% end %>
		</table>
	</div>
<% else %>
	<h2>No blog posts that match your search were found</h2>
<% end %>

<% end %>
