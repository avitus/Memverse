<% page_title 'Scripture by heart · Memverse' %>
<section class="heritage-welcome">
  <div><span class="heritage-eyebrow">A little practice. A lasting treasure.</span><h1>Keep the Word<br>close to your heart.</h1><p>A quiet place to memorize Scripture, build a daily practice, and carry the words with you.</p><div class="heritage-actions"><%= link_to 'Begin with one verse', new_user_registration_path, class: 'heritage-primary' %><%= link_to 'Try a review', demo_path, class: 'heritage-secondary' %></div><small>Free to use. Learn at your own pace.</small></div>
  <blockquote>“Thy word have I hid in mine heart, that I might not sin against thee.”<cite>Psalm 119:11 · KJV</cite></blockquote>
</section>
<section class="heritage-home-section"><span class="heritage-eyebrow">A practice for life</span><h2>One verse at a time.</h2><div class="heritage-three-columns"><article><span class="heritage-eyebrow">01 · Choose</span><h3>Words that matter to you.</h3><p>Bring your own passage or explore popular verses in your preferred Bible translation.</p><%= link_to 'Explore popular verses →', popular_path %></article><article><span class="heritage-eyebrow">02 · Remember</span><h3>Return at the right time.</h3><p>Memverse schedules reviews to help you remember. Simply come back and practice.</p><%= link_to 'How review works →', supermemo_path %></article><article><span class="heritage-eyebrow">03 · Grow</span><h3>See your progress.</h3><p>Watch your collection grow, celebrate milestones, and find encouragement in the community.</p><%= link_to 'Meet the community →', leaderboard_path %></article></div></section>
<% if @blogposts.any? %><section class="heritage-home-section"><div class="heritage-page-heading"><h2>Words for the journey.</h2><%= link_to 'The journal →', bloggity.root_path %></div><div class="heritage-two-columns"><% @blogposts.each do |post| %><article><span class="heritage-eyebrow"><%= post.created_at.strftime('%B %d, %Y') %></span><h3><%= link_to post.title, blog_named_link(post) %></h3><p><%= truncate(strip_tags(post.body), length: 180) %></p><%= link_to 'Read article →', blog_named_link(post) %></article><% end %></div></section><% end %>
<section class="heritage-home-section heritage-actions"><%= link_to 'Getting started', tutorial_path %><%= link_to 'Watch the tutorial', 'https://www.youtube.com/watch?v=MAWn3qfkGrA' %><%= link_to 'Questions and answers', faq_path %></section>
