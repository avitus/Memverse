<div class="white-box-bg quiz-schedule-compact"
     data-controller="quiz-sse"
     data-quiz-sse-quiz-id-value="<%= @quiz.id %>"
     data-quiz-sse-events-url-value="/live_quiz/events">
  <div class="top-heading">
    <h2><i class="fa fa-calendar-check-o"></i> <%= @quiz.name %></h2>
  </div>

  <div class="quiz-schedule-grid">
    <!-- Next Quiz Card -->
    <% if @next_quiz_time %>
      <div class="quiz-card next-quiz-card">
        <div class="quiz-card-header">
          <h3>Next Quiz</h3>
          <span class="quiz-badge <%= @next_quiz_time < 1.hour.from_now ? 'quiz-badge-urgent' : 'quiz-badge-upcoming' %>">
            <%= @next_quiz_time < 1.hour.from_now ? 'Starting Soon' : 'Upcoming' %>
          </span>
        </div>
        <div class="quiz-card-content">
          <div class="next-quiz-time">
            <div class="quiz-day" data-utc-datetime="<%= @next_quiz_time.iso8601 %>">
              <!-- Day will be inserted by JavaScript -->
            </div>
            <div class="quiz-datetime">
              <div class="quiz-local-time" data-utc-datetime="<%= @next_quiz_time.iso8601 %>">
                <!-- Local date and time will be inserted by JavaScript -->
              </div>
            </div>
          </div>
          <div class="quiz-countdown-compact" id="quiz-countdown"
               data-target-time="<%= @next_quiz_time.iso8601 %>"
               data-quiz-sse-target="countdown">
            <!-- Countdown inserted by JS -->
          </div>
          <div class="quiz-sse-status" data-quiz-sse-target="status" style="font-size: 0.8em; color: #666; margin-top: 5px;">
            <!-- SSE connection status -->
          </div>
        </div>
      </div>
    <% end %>

    <!-- Schedule Card -->
    <div class="quiz-card schedule-card">
      <div class="quiz-card-header">
        <h3>Weekly Schedule</h3>
      </div>
      <div class="quiz-card-content">
        <div class="schedule-times">
          <% if @quiz_schedule %>
            <% @quiz_schedule.each do |schedule_item| %>
              <div class="schedule-time-item">
                <span class="schedule-day-name"><%= schedule_item[:day] %></span>
                <span class="schedule-local" data-utc-time="<%= schedule_item[:utc_time] %>"></span>
              </div>
            <% end %>
          <% else %>
            <div class="schedule-time-item">
              <span class="schedule-day-name">Tuesday</span>
              <span class="schedule-local" data-utc-time="17:00"></span>
            </div>
            <div class="schedule-time-item">
              <span class="schedule-day-name">Saturday</span>
              <span class="schedule-local" data-utc-time="23:00"></span>
            </div>
          <% end %>
        </div>
      </div>
    </div>
    
    <!-- Quiz Details Card -->
    <div class="quiz-card details-card">
      <div class="quiz-card-header">
        <h3>Quiz Details</h3>
      </div>
      <div class="quiz-card-content">
        <div class="quiz-stats">
          <div class="quiz-stat">
            <i class="fa fa-clock-o"></i>
            <span>20 minutes</span>
          </div>
          <div class="quiz-stat">
            <i class="fa fa-question-circle"></i>
            <span>25 questions</span>
          </div>
          <div class="quiz-stat">
            <i class="fa fa-trophy"></i>
            <span>Live scoring</span>
          </div>
        </div>
        <div class="quiz-action-compact">
          <button class="submit" onclick="alert('Quiz notifications are sent to all active members. Make sure your email preferences are set to receive quiz reminders.');">
            <i class="fa fa-bell"></i> Get Notified
          </button>
        </div>
      </div>
    </div>
  </div>
  
  <div class="quiz-footer-note">
    <i class="fa fa-info-circle"></i> Quiz automatically starts at scheduled time. Join at <a href="/live_quiz">/live_quiz</a> when ready.
  </div>
</div>

<script type="text/javascript">
  // Initialize quiz time display
  $(document).ready(function() {
    if (typeof quizSchedule !== 'undefined') {
      // Convert next quiz time to local timezone
      if (quizSchedule.showNextQuizLocalTime) {
        quizSchedule.showNextQuizLocalTime();
      }

      // Convert weekly schedule times to local timezone
      if (quizSchedule.showLocalTimes) {
        quizSchedule.showLocalTimes();
      }

      // Also initialize the countdown
      if (quizSchedule.initCountdown) {
        quizSchedule.initCountdown();
      }
    }
  });
</script>

