<% page_title "Live Quiz :: " + @quiz.name %>

<!-- Quiz instructions : Pop-up box -->
<%= render partial: "instructions" %>

<div class="white-box-with-margins" 
     data-controller="live-quiz"
     data-live-quiz-quiz-id-value="<%= @quiz.id %>"
     data-live-quiz-user-id-value="<%= current_user.id %>"
     data-live-quiz-user-name-value="<%= current_user.name_or_login %>"
     data-live-quiz-user-login-value="<%= current_user.login %>"
     data-live-quiz-translation-value="<%= current_user.translation %>"
     data-live-quiz-num-questions-value="<%= @num_questions %>"
     data-live-quiz-pubnub-subscribe-key-value="<%= PN.env[:subscribe_key] %>"
     data-live-quiz-pubnub-publish-key-value="<%= PN.env[:publish_key] %>"
     style="position:relative">

	<!-- TOP QUIZ HEADER -->
	<div id="quiz-header" class="bg-gradient-to-r from-blue-500 to-purple-600 text-white p-4 rounded-t-lg">
		<div class="flex justify-between items-center">
			<h1 id="quiz-name" class="text-2xl font-bold"><%= @quiz.name %></h1>
			<div class="flex items-center space-x-4">
				<div id="quiz-timer" data-live-quiz-target="timer" class="text-xl font-mono">
					<%= @minutes %>:<%= @seconds.to_s.rjust(2, '0') %>
				</div>
				<div id="quizzers-stats" class="quiz-button bg-white text-blue-600 px-3 py-1 rounded cursor-pointer">
					Participants: <span id="quizzers-count" data-live-quiz-target="participantCount">0</span>
				</div>
			</div>
		</div>
		<div id="countdown-till" class="text-sm mt-2 opacity-90">
			<!-- Status will be shown here -->
		</div>
	</div>

	<!-- ROSTER WINDOW -->
	<div id="roster-window" class="hidden absolute top-16 right-3 w-80 max-h-96 overflow-y-auto bg-gray-50 p-4 rounded-lg shadow-lg z-10">
		<!-- Participants will be dynamically added here -->
	</div>

	<!-- QUIZ QUESTIONS -->
	<div id="live-quiz" class="p-6">
		<div id="questions-answers">
			<!-- Progress Dots -->
			<div class="mb-6">
				<h3 class="text-lg font-semibold mb-3">Questions</h3>
				<div class="flex flex-wrap gap-2">
					<% for q in 1..@num_questions %>
						<span class="q-dot w-8 h-8 bg-gray-200 rounded-full flex items-center justify-center text-sm font-medium hover:bg-gray-300 transition-colors cursor-pointer"
						      data-live-quiz-target="questionDot"
						      id="dot-<%= q %>">
							<%= q %>
						</span>
					<% end %>
				</div>
			</div>

			<!-- Question Display Area -->
			<div class="space-y-4">
				<% for q in 1..@num_questions %>
					<div data-live-quiz-target="question"
					     data-question-number="<%= q %>"
					     id="question-<%= q %>" 
					     class="question bg-gray-50 p-6 rounded-lg"
					     style="display:none">
						<div id="q-msg" class="text-sm text-gray-600 mb-2"></div>
						<div id="q-question" class="text-lg"></div>
						<div id="q-answer" data-live-quiz-target="answer" class="mt-4 p-4 bg-green-50 rounded"></div>
					</div>
				<% end %>
			</div>
		</div>
	</div>

	<div class="grid grid-cols-1 md:grid-cols-2 gap-6 p-6">
		<!-- SCOREBOARD -->
		<div id="live-scoreboard" class="bg-gray-50 p-4 rounded-lg">
			<h3 class="text-lg font-semibold mb-3">Scoreboard</h3>
			<div data-live-quiz-target="scoreboard" id="live-quiz-scores">
				<p class="text-sm text-gray-600">Scores are updated at the end of each question.</p>
			</div>
		</div>

		<!-- CHAT WINDOW -->
		<div id="chat-window" class="bg-gray-50 p-4 rounded-lg">
			<div class="flex justify-between items-center mb-3">
				<h3 class="text-lg font-semibold">
					Chat (<span data-live-quiz-target="chatStatus" id="chat_status"><%= @channel.status %></span>)
				</h3>
				<% if can? :manage, Quiz %>
					<%= link_to "Toggle Status", 
					    { controller: "chat", action: "toggle_channel", channel: @channel.channel }, 
					    remote: true,
					    class: "text-sm text-blue-600 hover:underline" %>
				<% end %>
			</div>

			<div data-live-quiz-target="chatArea" 
			     id="chat-stream-narrow" 
			     class="h-64 overflow-y-auto bg-white p-3 rounded border mb-3">
				<!-- Chat messages will appear here -->
			</div>

			<div class="flex space-x-2">
				<input type="text" 
				       data-live-quiz-target="chatInput"
				       placeholder="Type your message..." 
				       class="flex-1 px-3 py-2 border rounded focus:outline-none focus:ring-2 focus:ring-blue-500"
				       autocomplete="off">
				<button onclick="sendQuizChat()"
				        class="px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700 transition-colors">
					Send
				</button>
			</div>
		</div>
	</div>
	
	<div class="clr"></div>
</div>


<!-- Initialize legacy JavaScript variables and load quiz scripts -->
<script type="text/javascript">
	// Set global variables for legacy code
	var memverseUserID    = "<%= current_user.id %>";
	var memverseUserName  = "<%= current_user.name_or_login.html_safe %>";
	var memverseUserLogin = "<%= current_user.login.html_safe %>";
	var quizID = "<%= @quiz.id %>";
	var channel = "quiz-<%= @quiz.id %>";
	var translation = "<%= current_user.translation %>";
	
	// Initialize quiz when document is ready
	$(document).ready(function() {
		// Set up quiz room for user
		quizRoom.initialize('<%= @num_questions %>');
		
		console.log("==> Connected to channel " + channel);
		
		// Initialize PubNub with v7+ SDK
		var pubnub = new PubNub({
			subscribeKey: '<%= PN.env[:subscribe_key] %>',
			publishKey: '<%= PN.env[:publish_key] %>',
			logVerbosity: false,
			userId: memverseUserID,
			ssl: true,
			restore: true,
			keepAlive: true
		});
		
		// Add PubNub event listeners
		pubnub.addListener({
			message: function(message) {
				console.log("Received message:", message);
				quizRoom.handleMessage(message.message);
			},
			presence: function(presenceEvent) {
				console.log("Presence event:", presenceEvent);
				if (typeof mvPresence === 'function') {
					mvPresence(presenceEvent);
				}
			},
			status: function(statusEvent) {
				console.log("Status event:", statusEvent);
				if (statusEvent.category === "PNConnectedCategory") {
					console.log("Successfully connected to PubNub");
					// Call the connection callback from memverse_live_quiz.js
					if (typeof mvConnect === 'function') {
						mvConnect(pubnub);
					}
				}
			}
		});
		
		// Subscribe to the quiz channel with presence
		pubnub.subscribe({
			channels: [channel],
			withPresence: true
		});
		
		// Make PubNub instance globally available
		window.pubnub = pubnub;
		window.PUBNUB = pubnub; // Some legacy code might use uppercase
		
		// Set quiz status
		$.getJSON('/live_quiz/till_start/<%= @quiz.id %>.json', function(data) {
			if (data.status) {
				$("#countdown-till").html("<strong>Quiz Status:</strong> " + data.status);
			} else {
				$('#quiz-timer').countdown({until: data.time, significant: 2});
				$("#countdown-till").text("till quiz starts");
			}
		});
		
		// Handle chat input
		$('[data-live-quiz-target="chatInput"]').on('keypress', function(e) {
			if (e.which === 13) {
				sendQuizChat();
			}
		});
		
		// Show roster window
		$("#quizzers-stats").click(quizRoom.toggleQuizzersWindow);
		
		// Show previous questions functionality
		$("#questions-answers").delegate("span.q-dot", "click", function(){
			var active_question = !($(".q-dot.current").hasClass("completed"));
			if(!active_question && $(this).hasClass("completed")) {
				$(".q-dot.current").removeClass("current");
				$(this).addClass("current");
				
				var q_no = $(this).attr("id").replace("dot-","");
				
				$(".question").removeClass("active").addClass("hidden");
				$("#question-"+q_no).removeClass("hidden").addClass("active");
			}
		});
	});
	
	// Global function for sending chat messages
	function sendQuizChat() {
		var input = $('[data-live-quiz-target="chatInput"]');
		var message = input.val().trim();
		
		if (message && window.pubnub) {
			// Send chat through PubNub using the format expected by memverse_live_quiz.js
			window.pubnub.publish({
				channel: channel,
				message: {
					meta: 'chat',
					data: {
						user: memverseUserLogin,
						user_id: memverseUserID,
						msg: message
					}
				}
			}, function(status, response) {
				if (!status.error) {
					input.val('');
				} else {
					console.error("Failed to send chat:", status);
				}
			});
		}
	}
</script>