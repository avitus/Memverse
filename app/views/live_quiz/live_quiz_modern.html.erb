<% page_title "Live Quiz :: " + @quiz.name %>

<!-- Quiz instructions : Pop-up box -->
<%= render partial: "instructions" %>

<div class="white-box-with-margins" 
     data-controller="live-quiz"
     data-live-quiz-quiz-id-value="<%= @quiz.id %>"
     data-live-quiz-user-id-value="<%= current_user.id %>"
     data-live-quiz-user-name-value="<%= current_user.name_or_login %>"
     data-live-quiz-user-login-value="<%= current_user.login %>"
     data-live-quiz-translation-value="<%= current_user.translation %>"
     data-live-quiz-num-questions-value="<%= @num_questions %>"
     data-live-quiz-pubnub-subscribe-key-value="<%= PN.env[:subscribe_key] %>"
     data-live-quiz-pubnub-publish-key-value="<%= PN.env[:publish_key] %>"
     style="position:relative">

	<!-- TOP QUIZ HEADER -->
	<div id="quiz-header" class="bg-gradient-to-r from-blue-500 to-purple-600 text-white p-4 rounded-t-lg">
		<div class="flex justify-between items-center">
			<h1 id="quiz-name" class="text-2xl font-bold"><%= @quiz.name %></h1>
			<div class="flex items-center space-x-4">
				<div data-live-quiz-target="timer" class="text-xl font-mono">
					<%= @minutes %>:<%= @seconds.to_s.rjust(2, '0') %>
				</div>
				<div class="quiz-button bg-white text-blue-600 px-3 py-1 rounded">
					Participants: <span data-live-quiz-target="participantCount">0</span>
				</div>
			</div>
		</div>
		<div id="countdown-till" class="text-sm mt-2 opacity-90">
			<!-- Status will be shown here -->
		</div>
	</div>

	<!-- QUIZ QUESTIONS -->
	<div id="live-quiz" class="p-6">
		<div id="questions-answers">
			<!-- Progress Dots -->
			<div class="mb-6">
				<h3 class="text-lg font-semibold mb-3">Questions</h3>
				<div class="flex flex-wrap gap-2">
					<% for q in 1..@num_questions %>
						<span class="q-dot w-8 h-8 bg-gray-200 rounded-full flex items-center justify-center text-sm font-medium hover:bg-gray-300 transition-colors cursor-pointer"
						      data-live-quiz-target="questionDot"
						      id="dot-<%= q %>">
							<%= q %>
						</span>
					<% end %>
				</div>
			</div>

			<!-- Question Display Area -->
			<div class="space-y-4">
				<% for q in 1..@num_questions %>
					<div data-live-quiz-target="question"
					     data-question-number="<%= q %>"
					     id="question-<%= q %>" 
					     class="question bg-gray-50 p-6 rounded-lg hidden">
						<div class="q-msg text-sm text-gray-600 mb-2"></div>
						<div class="q-question text-lg"></div>
						<div data-live-quiz-target="answer" class="q-answer mt-4 p-4 bg-green-50 rounded hidden"></div>
					</div>
				<% end %>
			</div>
		</div>
	</div>

	<div class="grid grid-cols-1 md:grid-cols-2 gap-6 p-6">
		<!-- SCOREBOARD -->
		<div id="live-scoreboard" class="bg-gray-50 p-4 rounded-lg">
			<h3 class="text-lg font-semibold mb-3">Scoreboard</h3>
			<div data-live-quiz-target="scoreboard" id="live-quiz-scores">
				<p class="text-sm text-gray-600">Scores are updated at the end of each question.</p>
			</div>
		</div>

		<!-- CHAT WINDOW -->
		<div id="chat-window" class="bg-gray-50 p-4 rounded-lg">
			<div class="flex justify-between items-center mb-3">
				<h3 class="text-lg font-semibold">
					Chat (<span data-live-quiz-target="chatStatus" id="chat_status"><%= @channel.status %></span>)
				</h3>
				<% if can? :manage, Quiz %>
					<%= link_to "Toggle Status", 
					    { controller: "chat", action: "toggle_channel", channel: @channel.channel }, 
					    remote: true,
					    class: "text-sm text-blue-600 hover:underline" %>
				<% end %>
			</div>

			<div data-live-quiz-target="chatArea" 
			     id="chat-stream-narrow" 
			     class="h-64 overflow-y-auto bg-white p-3 rounded border mb-3">
				<!-- Chat messages will appear here -->
			</div>

			<div class="flex space-x-2">
				<input type="text" 
				       data-live-quiz-target="chatInput"
				       placeholder="Type your message..." 
				       class="flex-1 px-3 py-2 border rounded focus:outline-none focus:ring-2 focus:ring-blue-500"
				       autocomplete="off">
				<button onclick="sendQuizChat()"
				        class="px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700 transition-colors">
					Send
				</button>
			</div>
		</div>
	</div>
	
	<div class="clr"></div>
</div>

<!-- Styles for quiz elements -->
<style>
	.q-dot.current {
		@apply bg-blue-500 text-white;
	}
	
	.q-dot.completed {
		@apply bg-green-500 text-white;
	}
	
	.question.active {
		@apply block;
	}
	
	.question.hidden {
		@apply hidden;
	}
	
	.mcq-option {
		@apply w-full text-left px-4 py-3 bg-white border rounded hover:bg-blue-50 transition-colors;
	}
	
	.mcq-option.selected {
		@apply bg-blue-100 border-blue-500;
	}
	
	.chat-entry {
		@apply mb-2 text-sm;
	}
	
	.chat-timestamp {
		@apply text-gray-500 mr-2;
	}
	
	.chat-user {
		@apply font-semibold mr-1;
	}
	
	.chat-system .chat-user {
		@apply text-blue-600;
	}
	
	.notification {
		@apply fixed bottom-4 right-4 px-6 py-3 rounded-lg shadow-lg z-50;
		animation: slideIn 0.3s ease-out;
	}
	
	.notification-success {
		@apply bg-green-500 text-white;
	}
	
	.notification-error {
		@apply bg-red-500 text-white;
	}
	
	.notification-warning {
		@apply bg-yellow-500 text-white;
	}
	
	.notification-info {
		@apply bg-blue-500 text-white;
	}
	
	@keyframes slideIn {
		from {
			transform: translateX(100%);
			opacity: 0;
		}
		to {
			transform: translateX(0);
			opacity: 1;
		}
	}
	
	.answer-reveal {
		animation: fadeIn 0.5s ease-out;
	}
	
	@keyframes fadeIn {
		from {
			opacity: 0;
		}
		to {
			opacity: 1;
		}
	}
</style>

<!-- Use legacy JavaScript since Stimulus controller isn't loaded -->
<script type="text/javascript">
	// Set global variables for legacy code
	var memverseUserID    = "<%= current_user.id %>";
	var memverseUserName  = "<%= current_user.name_or_login.html_safe %>";
	var memverseUserLogin = "<%= current_user.login.html_safe %>";
	var channel = "quiz-<%= @quiz.id %>";
	var translation = "<%= current_user.translation %>";
	
	$(document).ready(function() {
		console.log('Initializing legacy quiz JavaScript');
		
		// Initialize legacy quiz room
		quizRoom.initialize('<%= @num_questions %>');
		
		// Initialize PubNub with v7+ SDK
		var pubnub = new PubNub({
			subscribeKey: '<%= PN.env[:subscribe_key] %>',
			publishKey: '<%= PN.env[:publish_key] %>',
			logVerbosity: true,
			userId: memverseUserID,
			uuid: memverseUserID, // Also set uuid for legacy compatibility
			ssl: true,
			presenceTimeout: 130,
			heartbeatInterval: 30,
			suppressLeaveEvents: false,
			restore: true
		});

		console.log("==> Connecting to channel " + channel);

		// Add message listener for v7 API
		pubnub.addListener({
			message: function(event) {
				console.log("==> Message received:", event.message);
				quizRoom.handleMessage(event.message);
			},
			presence: function(event) {
				console.log("==> Presence event:", event);
				// Update participant count
				if (event.occupancy !== undefined) {
					updateParticipantCount(event.occupancy);
				}
				// Handle legacy presence callback
				if (typeof mvPresence === 'function') {
					mvPresence(event);
				}
			},
			status: function(event) {
				console.log("==> Status event:", event);
				if (event.category === "PNConnectedCategory") {
					console.log("==> Successfully connected to PubNub");
				}
			}
		});

		// Subscribe to quiz channel with presence
		pubnub.subscribe({
			channels: [channel],
			withPresence: true
		});

		// Connect function called after subscription
		setTimeout(function() {
			mvConnect(pubnub);
		}, 1000);
		
		// Adapt legacy quiz functions to work with modern HTML
		window.showQuizQuestion = function(qNum, qShow, qAnswer, qType, qData) {
			console.log("==> Showing question " + qNum + " (type: " + qType + "): " + qShow);
			
			// Update progress dots
			$('.q-dot').removeClass('current completed');
			for (var i = 1; i < qNum; i++) {
				$('#dot-' + i).addClass('completed');
			}
			$('#dot-' + qNum).addClass('current');
			
			// Hide all questions and show current one
			$('.question').removeClass('active').addClass('hidden');
			var $question = $('#question-' + qNum);
			$question.removeClass('hidden').addClass('active');
			
			// Set question content
			$question.find('.q-question').html(qShow);
			
			// Handle MCQ questions specially
			if (qType === 'mcq' && qData) {
				var mcqHtml = setupMCQ(qData.mc_option_a, qData.mc_option_b, qData.mc_option_c, qData.mc_option_d, qData.mc_answer, qNum);
				$question.find('.q-answer').html(mcqHtml).removeClass('hidden');
			} else {
				$question.find('.q-answer').html(qAnswer).addClass('hidden');
			}
			
			return $question;
		};
		
		// Override the legacy showTime function to work with modern timer
		window.showTime = function(seconds) {
			var minutes = Math.floor(seconds / 60);
			var secs = seconds % 60;
			var timeStr = minutes + ':' + (secs < 10 ? '0' : '') + secs;
			$('[data-live-quiz-target="timer"]').text(timeStr);
			$('#quiz-timer').text(timeStr);
		};
		
		// Override legacy chat display to work with modern HTML
		window.displayQuizChat = function(user, message, type, userId) {
			var timestamp = new Date().toLocaleTimeString('en-US', { 
				hour: '2-digit', 
				minute: '2-digit' 
			});
			
			var chatHtml = '<div class="chat-entry chat-' + type + '">' +
				'<span class="chat-timestamp">' + timestamp + '</span>' +
				'<span class="chat-user" data-user-id="' + (userId || '') + '">' + user + ':</span> ' +
				'<span class="chat-message">' + message + '</span>' +
				'</div>';
			
			$('[data-live-quiz-target="chatArea"]').append(chatHtml);
			$('#chat-stream-narrow').append(chatHtml);
			
			// Auto-scroll to bottom
			var chatArea = $('[data-live-quiz-target="chatArea"]')[0];
			if (chatArea) {
				chatArea.scrollTop = chatArea.scrollHeight;
			}
		};
		
		// Override participant count update
		window.updateParticipantCount = function(count) {
			$('[data-live-quiz-target="participantCount"]').text(count);
			$('#quizzers-count').text(count);
		};
		
		// Override scoreboard display
		window.displayScoreboard = function(scoreboard) {
			if (!scoreboard || scoreboard.length === 0) return;
			
			var sortedScores = scoreboard.sort(function(a, b) {
				return b.score - a.score;
			});
			
			var html = '<h4 class="font-bold mb-2">Leaderboard</h4><ol class="space-y-1">';
			sortedScores.slice(0, 10).forEach(function(participant, index) {
				var medal = index === 0 ? '🥇' : index === 1 ? '🥈' : index === 2 ? '🥉' : '';
				html += '<li class="flex justify-between">' +
					'<span>' + medal + ' ' + (index + 1) + '. ' + participant.name + '</span>' +
					'<span class="font-mono">' + participant.score + '</span>' +
					'</li>';
			});
			html += '</ol>';
			
			$('[data-live-quiz-target="scoreboard"]').html(html);
			$('#live-quiz-scores').html(html);
		};
		
		// Make PubNub global for chat functionality
		window.pubnub = pubnub;
		
		// Add chat sending functionality
		window.sendQuizChat = function() {
			var $input = $('[data-live-quiz-target="chatInput"]');
			var message = $input.val().trim();
			
			if (message === '') {
				alert("Please put text in your message.");
				return false;
			}
			
			// Publish chat message
			window.pubnub.publish({
				channel: channel,
				message: {
					meta: 'chat',
					data: {
						user: memverseUserName,
						user_id: memverseUserID,
						msg: message
					}
				}
			}).then(function(response) {
				console.log("Chat message sent:", response);
				$input.val(''); // Clear input
			}).catch(function(error) {
				console.error("Failed to send chat:", error);
			});
		};
		
		// Handle Enter key for chat
		$('[data-live-quiz-target="chatInput"]').on('keypress', function(e) {
			if (e.which === 13) { // Enter key
				sendQuizChat();
				return false;
			}
		});
	});
</script>