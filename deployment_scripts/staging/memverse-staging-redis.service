[Unit]
Description=Isolated Redis for Memverse redesign staging
After=network.target

[Service]
User=redis
Group=redis
ExecStart=/usr/bin/redis-server /etc/redis/memverse-staging.conf
Restart=on-failure
StateDirectory=memverse-staging-redis
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
