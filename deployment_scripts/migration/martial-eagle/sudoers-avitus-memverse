# Memverse deploy user on martial-eagle. Every entry is the exact argument string that
# lib/capistrano/tasks/sidekiq_multi.rake (or the runbook) sends; there are no sudoers wildcards, so no
# extra arguments, unit paths or pager invocations can be smuggled in. The two '\*' entries match the
# literal string sidekiq-workers@* that Capistrano passes (systemctl expands it, sudo does not).
# Unit files are installed and enabled by root (plan §7.6) and are not writable by avitus; enable/disable
# are deliberately absent. Two worker instances are enumerated; adding a third means adding its lines here.
# Install with:
#   sudo install -m 0440 sudoers-avitus-memverse /etc/sudoers.d/avitus-memverse && sudo visudo -cf /etc/sudoers.d/avitus-memverse
avitus ALL=(root) NOPASSWD: /usr/bin/systemctl start sidekiq-scheduler, /usr/bin/systemctl stop sidekiq-scheduler, /usr/bin/systemctl restart sidekiq-scheduler, /usr/bin/systemctl kill -s TSTP sidekiq-scheduler, /usr/bin/systemctl status sidekiq-scheduler --no-pager
avitus ALL=(root) NOPASSWD: /usr/bin/systemctl start sidekiq-workers@1, /usr/bin/systemctl start sidekiq-workers@2, /usr/bin/systemctl restart sidekiq-workers@1, /usr/bin/systemctl restart sidekiq-workers@2, /usr/bin/systemctl kill -s TSTP sidekiq-workers@1, /usr/bin/systemctl kill -s TSTP sidekiq-workers@2
avitus ALL=(root) NOPASSWD: /usr/bin/systemctl stop sidekiq-workers@\*, /usr/bin/systemctl kill -s TSTP sidekiq-workers@\*, /usr/bin/systemctl status sidekiq-workers@\* --no-pager
avitus ALL=(root) NOPASSWD: /usr/bin/systemctl start memverse-searchd, /usr/bin/systemctl stop memverse-searchd, /usr/bin/systemctl restart memverse-searchd, /usr/bin/systemctl status memverse-searchd --no-pager
avitus ALL=(root) NOPASSWD: /usr/bin/systemctl reload nginx
avitus ALL=(root) NOPASSWD: /usr/bin/journalctl -u sidekiq-scheduler -n 50 --no-pager, /usr/bin/journalctl -u sidekiq-workers@1 -n 50 --no-pager, /usr/bin/journalctl -u sidekiq-workers@2 -n 50 --no-pager
