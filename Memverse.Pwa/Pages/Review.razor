@page "/review"
@page "/review/{PassageId:long}"
@implements IDisposable
@inject MemverseState State
@inject IOfflineOperations Offline
@inject IOnlineOperations Online
@inject NavigationManager Navigation
@inject IJSRuntime JS
<PageTitle>Review - Memverse</PageTitle>
@if (currentReview is { } model)
{
    RenderFragment<Memverse> ratingChips = verse => @<span class="review-verse-ratings" role="group" aria-label="@($"{verse.Reference} rating")">
        @for (var rating = 1; rating <= 5; rating++)
        {
            var value = rating;
            <button type="button" class="review-rating-chip"
                    aria-pressed="@(model.GetRating(verse) == value ? "true" : "false")"
                    aria-label="@($"Rate {verse.Reference}: {value}")"
                    @onclick="() => model.ToggleRating(verse, value)">@value</button>
        }
    </span>;

    <article class="review-card card">
        <div class="review-heading">
            <NavLink class="review-back" href="passages" aria-label="Back to My passages">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6M9 12h12" /></svg>
            </NavLink>
            <p class="eyebrow">@model.PassageReference · @model.CurrentVerse.Translation</p>
            <small>Verse @(model.VerseIndex + 1) of @model.CurrentSection.Count</small>
        </div>

        @if (model.VerseIndex > 0)
        {
            <div @ref="reviewHistory" class="review-context" role="region" aria-label="Verses reviewed today" tabindex="0">
                @foreach (var verse in model.CurrentSection.Take(model.VerseIndex))
                {
                    <p @key="verse.Id">
                        <sup>@verse.VerseNumber</sup> @verse.Text
                        @ratingChips(verse)
                    </p>
                }
            </div>
        }

        <div class="review-live-text" aria-live="polite">
            <sup>@model.CurrentVerse.VerseNumber</sup>
            @if (model.FeedbackWords.Count == 0)
            {
                <span class="review-waiting">Waiting for you to begin typing...</span>
            }
            @foreach (var word in model.FeedbackWords)
            {
                var correct = word.Kind == MatchKind.Correct;
                var blank = word.Kind == MatchKind.None;
                <span class="review-word-slot @(blank ? "review-word-blank" : correct ? "review-word-correct" : "review-word-error")"
                      role="@(blank ? "img" : null)"
                      aria-label="@(blank ? "Blank word" : null)">
                    <span class="review-word-measure" aria-hidden="true">@word.Text</span>
                    <span class="review-word-value">@(blank ? "" : correct ? word.Text : "...")</span>
                </span>
            }
            @if (model.IsCorrect || model.GetRating(model.CurrentVerse) is not null)
            {
                @ratingChips(model.CurrentVerse)
            }
        </div>

        <textarea id="verse-entry"
                  @key="model.CurrentVerse.Id"
                  @ref="verseEntry"
                  class="form-control review-input @(model.IsCorrect ? "review-input-correct" : "")"
                  rows="3"
                  value="@model.InputText"
                  data-rating-enabled="@(model.CorrectVerse is not null ? "true" : "false")"
                  @oninput="UpdateInput"
                  @onkeydown="HandleKeyDown"
                  aria-label="Type @model.CurrentVerse.Reference"
                  autofocus
                  autocomplete="off"
                  autocapitalize="off"
                  autocorrect="off"
                  spellcheck="false"></textarea>

        @if (!model.IsCorrect && model.ShowAnswer)
        {
            <p class="verse-text answer"><sup>@model.CurrentVerse.VerseNumber</sup> @model.CurrentVerse.Text</p>
        }

        <div class="review-actions">
            <p class="review-feedback @(model.CorrectVerse is not null ? "success" : "")" role="status">
                @if (model.CorrectVerse is { } correctVerse)
                {
                    <span class="review-checkmark" aria-hidden="true">&#10003;</span>
                    <span>
                        @if (model.IsCorrect &&
                            model.CurrentSection.Take(model.VerseIndex).Any(verse => model.GetRating(verse) is null))
                        {
                            @if (model.GetRating(correctVerse) is not null)
                            {
                                <text>Correct! Rate the remaining unrated verses to finish this passage.</text>
                            }
                            else if (model.CurrentSection.Any(verse => model.GetRating(verse) is not null))
                            {
                                <text>Correct! Rate @correctVerse.Reference first, then rate the remaining unrated verses.</text>
                            }
                            else
                            {
                                <text>Correct! Choose a rating for the whole passage to finish.</text>
                            }
                        }
                        else
                        {
                            <text>Correct! Rate @correctVerse.Reference@(model.IsCorrect ? " to continue." : " or keep typing the next verse.")</text>
                        }
                    </span>
                }
                else
                {
                    <span>Type the verse, or use a hint if you need help.</span>
                }
            </p>
        </div>
        <div class="rating-panel">
            <div class="rating-actions">
                <button class="rating rating-fail" @onclick="() => Rate(1)"><strong>1</strong><span>don't know</span></button>
                <button class="rating rating-fail" @onclick="() => Rate(2)"><strong>2</strong><span>needed hint</span></button>
                <button class="rating" @onclick="() => Rate(3)" disabled="@(model.CorrectVerse is null)"><strong>3</strong><span>difficult</span></button>
                <button class="rating" @onclick="() => Rate(4)" disabled="@(model.CorrectVerse is null)"><strong>4</strong><span>hesitated</span></button>
                <button class="rating" @onclick="() => Rate(5)" disabled="@(model.CorrectVerse is null)"><strong>5</strong><span>perfect</span></button>
                <button class="btn btn-primary" title="Hint (Ctrl+Space)" @onclick="UseHint" disabled="@model.IsCorrect">Hint</button>
            </div>
        </div>
    </article>
}
else
{
    <div class="card empty review-empty">
        <NavLink class="review-back" href="passages" aria-label="Back to My passages">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6M9 12h12" /></svg>
        </NavLink>
        <h2>All caught up</h2><p>There are no passages due for review.</p>
    </div>
}

@code {
    [Parameter] public long? PassageId { get; set; }

    private ReviewVersesViewModel? currentReview;
    private ElementReference verseEntry;
    private ElementReference reviewHistory;
    private Memverse? lastRenderedVerse;
    private bool focusEntryAfterRender;
    private bool initialized;
    private long? initializedPassageId;

    protected override void OnParametersSet()
    {
        if (initialized && initializedPassageId == PassageId)
            return;

        focusEntryAfterRender = false;
        lastRenderedVerse = null;
        initialized = true;
        initializedPassageId = PassageId;
        currentReview = ReviewVersesViewModel.Create(
            State.Verses,
            State.User?.TargetVersesPerDay ?? 15,
            DateTime.Today,
            Offline.QueueReviewChanges,
            PassageId);
        focusEntryAfterRender = currentReview is not null;
        if (currentReview is null)
            Navigation.NavigateTo("", replace: true);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (currentReview is not { } review)
            return;

        var verseChanged = review.CurrentVerse != lastRenderedVerse;
        if (focusEntryAfterRender || review.VerseIndex > 0 && verseChanged)
        {
            focusEntryAfterRender = false;
            await verseEntry.FocusAsync();
        }

        if (verseChanged)
        {
            lastRenderedVerse = review.CurrentVerse;
            await using var module = await JS.InvokeAsync<IJSObjectReference>("import", "./Pages/Review.razor.js");
            await module.InvokeVoidAsync("preventRatingInput", verseEntry);
            if (review.VerseIndex > 0)
                await module.InvokeVoidAsync("scrollToBottom", reviewHistory);
        }
    }

    private void UpdateInput(ChangeEventArgs args) =>
        currentReview!.UpdateInput(args.Value?.ToString() ?? "");

    private void UseHint()
    {
        focusEntryAfterRender = true;
        currentReview!.UseHint();
    }

    private void HandleKeyDown(KeyboardEventArgs args)
    {
        if (currentReview is not { } review)
            return;

        if (args.CtrlKey && args.Code == "Space" &&
            !review.IsCorrect)
        {
            UseHint();
            return;
        }

        if (review.CorrectVerse is not null &&
            args.Key.Length == 1 &&
            args.Key[0] is >= '1' and <= '5')
            Rate(args.Key[0] - '0');
    }

    private void Rate(int rating)
    {
        if (currentReview is not { } review || rating >= 3 && review.CorrectVerse is null)
            return;

        var hasMoreReview = review.Rate(rating);
        focusEntryAfterRender = hasMoreReview;
        if (!hasMoreReview)
            currentReview = null;
    }

    public void Dispose() => _ = Online.FlushBackgroundTasksAsync();
}
