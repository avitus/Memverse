@page "/review"
@page "/review/{PassageId:long}"
@implements IDisposable
@inject MemverseState State
@inject IOfflineOperations Offline
@inject IOnlineOperations Online
@inject NavigationManager Navigation
@inject IJSRuntime JS
<PageTitle>Review - Memverse</PageTitle>
@if (currentReview is { } model)
{
    <article class="review-card card">
        <div class="review-heading">
            <p class="eyebrow">@model.PassageReference · @model.CurrentVerse.Translation</p>
            <small>Verse @(model.VerseIndex + 1) of @model.CurrentSection.Count</small>
        </div>

        @if (model.VerseIndex > 0)
        {
            <div @ref="reviewHistory" class="review-context" role="region" aria-label="Verses reviewed today" tabindex="0">
                @foreach (var verse in model.CurrentSection.Take(model.VerseIndex))
                {
                    <p @key="verse.Id">
                        <sup>@verse.VerseNumber</sup> @verse.Text
                        <span class="review-verse-ratings" role="group" aria-label="@($"{verse.Reference} rating")">
                            @for (var rating = 1; rating <= 5; rating++)
                            {
                                var value = rating;
                                <button type="button" class="review-rating-chip"
                                        aria-pressed="@(model.GetRating(verse) == value ? "true" : "false")"
                                        aria-label="@($"Rate {verse.Reference}: {value}")"
                                        disabled="@savingRatings"
                                        @onclick="() => model.ToggleRating(verse, value)">@value</button>
                            }
                        </span>
                    </p>
                }
            </div>
        }

        <div class="review-live-text" aria-live="polite">
            <sup>@model.CurrentVerse.VerseNumber</sup>
            @if (model.FeedbackWords.Count == 0)
            {
                <span class="review-waiting">Waiting for you to begin typing...</span>
            }
            @foreach (var word in model.FeedbackWords)
            {
                var correct = word.Kind == MatchKind.Correct;
                <span class="review-word-slot @(correct ? "review-word-correct" : "review-word-error")">
                    <span class="review-word-measure" aria-hidden="true">@word.Text</span>
                    <span class="review-word-value">@(correct ? word.Text : "...")</span>
                </span>
            }
        </div>

        <textarea id="verse-entry"
                  @key="model.CurrentVerse.Id"
                  @ref="verseEntry"
                  class="form-control review-input @(model.IsCorrect ? "review-input-correct" : "")"
                  rows="3"
                  value="@model.InputText"
                  @oninput="UpdateInput"
                  @onkeydown="HandleKeyDown"
                  disabled="@savingRatings"
                  aria-label="Type @model.CurrentVerse.Reference"
                  autocomplete="off"
                  autocapitalize="off"
                  spellcheck="false"></textarea>

        @if (!model.IsCorrect && model.ShowAnswer)
        {
            <p class="verse-text answer"><sup>@model.CurrentVerse.VerseNumber</sup> @model.CurrentVerse.Text</p>
        }

        <div class="review-actions">
            @if (model.IsCorrect)
            {
                <p class="review-feedback success">Correct. Choose a rating below.</p>
            }
            else
            {
                <button class="btn btn-primary" title="Hint (Ctrl+Space)" @onclick="UseHint" disabled="@savingRatings">
                    Hint
                </button>
            }
        </div>
        <div class="rating-panel">
            <div class="rating-actions">
                <button class="rating rating-fail" @onclick="() => Rate(1)" disabled="@savingRatings"><strong>1</strong><span>don't know</span></button>
                <button class="rating rating-fail" @onclick="() => Rate(2)" disabled="@savingRatings"><strong>2</strong><span>needed hint</span></button>
                <button class="rating" @onclick="() => Rate(3)" disabled="@(savingRatings || !model.IsCorrect)"><strong>3</strong><span>difficult</span></button>
                <button class="rating" @onclick="() => Rate(4)" disabled="@(savingRatings || !model.IsCorrect)"><strong>4</strong><span>hesitated</span></button>
                <button class="rating" @onclick="() => Rate(5)" disabled="@(savingRatings || !model.IsCorrect)"><strong>5</strong><span>perfect</span></button>
            </div>
        </div>
    </article>
}
else
{
    <div class="card empty"><h2>All caught up</h2><p>There are no passages due for review.</p></div>
}

@code {
    [Parameter] public long? PassageId { get; set; }

    private ReviewVersesViewModel? currentReview;
    private ElementReference verseEntry;
    private ElementReference reviewHistory;
    private Memverse? lastScrolledVerse;
    private bool focusEntryAfterRender;
    private bool initialized;
    private long? initializedPassageId;
    private bool savingRatings;

    protected override void OnParametersSet()
    {
        if (initialized && initializedPassageId == PassageId)
            return;

        focusEntryAfterRender = false;
        lastScrolledVerse = null;
        initialized = true;
        initializedPassageId = PassageId;
        currentReview = ReviewVersesViewModel.Create(
            State.Verses,
            State.User?.TargetVersesPerDay ?? 15,
            DateTime.Today,
            verses => State.SaveVersesAsync(verses),
            PassageId);
        if (currentReview is null)
            Navigation.NavigateTo("", replace: true);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (currentReview is not null &&
            (focusEntryAfterRender ||
             currentReview.VerseIndex > 0 && currentReview.CurrentVerse != lastScrolledVerse))
        {
            focusEntryAfterRender = false;
            await verseEntry.FocusAsync();
        }

        if (currentReview is { } review &&
            review.VerseIndex > 0 && review.CurrentVerse != lastScrolledVerse)
        {
            lastScrolledVerse = review.CurrentVerse;
            await using var module = await JS.InvokeAsync<IJSObjectReference>("import", "./Pages/Review.razor.js");
            await module.InvokeVoidAsync("scrollToBottom", reviewHistory);
        }
    }

    private Task UpdateInput(ChangeEventArgs args) =>
        currentReview!.UpdateInputAsync(args.Value?.ToString() ?? "");

    private Task UseHint()
    {
        focusEntryAfterRender = true;
        return currentReview!.UseHintAsync();
    }

    private async Task HandleKeyDown(KeyboardEventArgs args)
    {
        if (savingRatings)
            return;

        if (args.CtrlKey && args.Code == "Space" &&
            !currentReview!.IsCorrect)
        {
            await UseHint();
            return;
        }

        if (currentReview!.IsCorrect &&
            args.Key.Length == 1 &&
            args.Key[0] is >= '1' and <= '5')
            await Rate(args.Key[0] - '0');
    }

    private async Task Rate(int rating)
    {
        var review = currentReview!;
        if (savingRatings || rating >= 3 && !review.IsCorrect)
            return;

        savingRatings = true;
        try
        {
            var hasMoreReview = await review.RateAsync(rating, Offline);
            if (ReferenceEquals(currentReview, review))
            {
                focusEntryAfterRender = hasMoreReview;
                if (!hasMoreReview)
                    currentReview = null;
            }
        }
        finally
        {
            savingRatings = false;
        }
    }

    public void Dispose() => _ = Online.FlushBackgroundTasksAsync();
}
