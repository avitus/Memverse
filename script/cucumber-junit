#!/usr/bin/env ruby
# Usage: script/cucumber-junit REPORT [cucumber args...]
#
# Cucumber's JUnit formatter writes one XML file per feature into a directory, but CircleCI
# Smarter Testing (.circleci/test-suites.yml) reads a single JUnit file. Runs Cucumber, merges
# the per-feature reports into REPORT and exits with Cucumber's status.
require 'fileutils'
require 'tmpdir'

XML_DECLARATION = /\A<\?xml[^>]*\?>\s*/
# Cucumber writes <system-out> and <system-err> into every test case, mostly empty. CircleCI
# records any test case with a <system-err> as "system-err" rather than "success", and testsuite
# then has no timings to size the job with. So drop the empty ones and keep stderr as stdout.
EMPTY_OUTPUT = %r{\s*<system-(out|err)>\s*<!\[CDATA\[\]\]>\s*</system-\1>}
SYSTEM_ERR_TAG = %r{<(/?)system-err>}

report, *cucumber_args = ARGV
abort "Usage: #{$PROGRAM_NAME} REPORT [cucumber args...]" unless report

status = Dir.mktmpdir('cucumber-junit') do |dir|
  system('bundle', 'exec', 'cucumber', '--format', 'junit,fileattribute=true', '--out', dir, *cucumber_args)
  exit_status = $?.exitstatus

  suites = Dir[File.join(dir, '*.xml')].sort.map do |file|
    File.read(file).sub(XML_DECLARATION, '').gsub(EMPTY_OUTPUT, '').gsub(SYSTEM_ERR_TAG, '<\1system-out>')
  end
  FileUtils.mkdir_p(File.dirname(report))
  File.write(report, %(<?xml version="1.0" encoding="UTF-8"?>\n<testsuites>\n#{suites.join}</testsuites>\n))
  exit_status
end

exit(status || 1)
